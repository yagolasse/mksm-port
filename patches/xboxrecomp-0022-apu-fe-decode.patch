diff --git a/src/apu/apu_mmio_hook.c b/src/apu/apu_mmio_hook.c
index 043b0ee..0b14e0b 100644
--- a/src/apu/apu_mmio_hook.c
+++ b/src/apu/apu_mmio_hook.c
@@ -254,12 +254,61 @@ static bool apu_decode_and_handle(PCONTEXT ctx, uint32_t mmio_offset, int is_wri
  * Public API (called from VEH in main.c)
  * ============================================================ */
 
+static int top_trace_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_APU_STATS");
+        on = e && *e && atoi(e) != 0;
+    }
+    return on;
+}
+
 bool apu_hook_handle_mmio(PCONTEXT ctx, uintptr_t fault_addr,
                           uint32_t fault_xbox_va, int is_write)
 {
     uint32_t mmio_offset = fault_xbox_va - APU_MMIO_BASE;
     DWORD64 rip = ctx->Rip;
+    /* RECOMP_APU_STATS: who rewrites the 2D voice list's top (DirectSound
+     * unlinking a voice; plan 3.3c). Host call stack of the writer, unwound
+     * from the fault context, with the old/new top; symbolize the RIPs with
+     * llvm-symbolizer and the PDB (rip - base + 0x140000000). First 60. */
+    if (is_write && mmio_offset == 0x2054 && top_trace_on() && g_apu_state) {
+        static unsigned n;
+        if (n++ < 60) {
+            CONTEXT c = *ctx;
+            uint32_t old = (uint32_t)mcpx_apu_mmio_read(g_apu_state, 0x2054, 4);
+            fprintf(stderr, "  [APU-TOP] t=%llu old=%X FECTL=%X FEDEC=%X/%X ISTS=%X"
+                    " base=%p stack:",
+                    (unsigned long long)GetTickCount64(), old,
+                    (uint32_t)mcpx_apu_mmio_read(g_apu_state, 0x1100, 4),
+                    (uint32_t)mcpx_apu_mmio_read(g_apu_state, 0x1300, 4),
+                    (uint32_t)mcpx_apu_mmio_read(g_apu_state, 0x1304, 4),
+                    (uint32_t)mcpx_apu_mmio_read(g_apu_state, 0x1000, 4),
+                    (void *)GetModuleHandleW(NULL));
+            for (int f = 0; f < 16 && c.Rip; f++) {
+                DWORD64 img = 0, est = 0;
+                PVOID hd = NULL;
+                PRUNTIME_FUNCTION rf = RtlLookupFunctionEntry(c.Rip, &img, NULL);
+                fprintf(stderr, " %llx", (unsigned long long)c.Rip);
+                if (!rf) {
+                    c.Rip = *(DWORD64 *)c.Rsp;   /* leaf */
+                    c.Rsp += 8;
+                    continue;
+                }
+                RtlVirtualUnwind(UNW_FLAG_NHANDLER, img, c.Rip, rf, &c, &hd,
+                                 &est, NULL);
+            }
+            fprintf(stderr, "\n");
+        }
+    }
     bool ok = apu_decode_and_handle(ctx, mmio_offset, is_write);
+    if (is_write && mmio_offset == 0x2054 && top_trace_on()) {
+        static unsigned n2;
+        if (n2++ < 60 && g_apu_state)
+            fprintf(stderr, "  [APU-TOP] new=%X\n",
+                    (uint32_t)mcpx_apu_mmio_read(g_apu_state, 0x2054, 4));
+    }
 
     /* RECOMP_APU_TRACE_SECTL=1: who switches the sample counter on and off
      * (SECTL.XCNTMODE). Host RIP of the writing instruction plus the module
diff --git a/src/apu/apu_state.h b/src/apu/apu_state.h
index b666b99..b3c159a 100644
--- a/src/apu/apu_state.h
+++ b/src/apu/apu_state.h
@@ -519,6 +519,8 @@ void mcpx_apu_vp_init(MCPXAPUState *d);
 void mcpx_apu_vp_finalize(MCPXAPUState *d);
 void mcpx_apu_vp_frame(MCPXAPUState *d, float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME]);
 void mcpx_apu_vp_reset(MCPXAPUState *d);
+void mcpx_apu_vp_dump_voices(MCPXAPUState *d);
+void mcpx_apu_reg_event(uint32_t what, uint32_t old, uint32_t val);
 
 /* DSP functions (stubbed) */
 void mcpx_apu_dsp_init(MCPXAPUState *d);
diff --git a/src/apu/apu_vp.c b/src/apu/apu_vp.c
index e6b1100..bb0cb1c 100644
--- a/src/apu/apu_vp.c
+++ b/src/apu/apu_vp.c
@@ -135,6 +135,16 @@ static struct {
     double frac;
 } s_rs[MCPX_HW_MAX_VOICES];
 
+/* RECOMP_APU_STATS=2: per-voice counters since the last [APU-VOICE] dump. */
+struct VoiceStat {
+    unsigned frames;        /* frames the voice produced samples in */
+    int peak;               /* source samples, before volume (x32767) */
+    uint16_t vol0, vol1;    /* attenuation of the first two bins (0xFFF = off) */
+    uint8_t bin0, bin1, list;
+    float rate;             /* source samples per output sample */
+};
+static struct VoiceStat s_vstat[MCPX_HW_MAX_VOICES];
+
 static void voice_resample_reset(uint16_t v)
 {
     s_rs[v].len = 0;
@@ -143,6 +153,7 @@ static void voice_resample_reset(uint16_t v)
 
 static void voice_off(MCPXAPUState *d, uint16_t v)
 {
+    if (mcpx_apu_stats_on()) g_apu_stats.off++;
     voice_set_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
                    NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE, 0);
 
@@ -195,12 +206,51 @@ static void set_hrir_coeff_tar(MCPXAPUState *d, int channel, int coeff_idx,
  * Front-End method dispatch
  * ============================================================ */
 
+/* RECOMP_APU_STATS: the last FE methods, for the dropped-voice report. */
+#define FE_RING 32
+static struct { uint32_t method, arg; } s_fe_ring[FE_RING];
+static unsigned s_fe_ring_pos;
+
+/* Register events for the same report: the title's writes to FECTL and the
+ * voice list registers (old -> new) and the idle-voice traps raised. */
+#define REG_RING 48
+static struct { uint32_t what, old, val; } s_reg_ring[REG_RING];
+static volatile long s_reg_ring_pos;
+
+void mcpx_apu_reg_event(uint32_t what, uint32_t old, uint32_t val)
+{
+    if (g_apu_stats.enabled > 0) {
+        unsigned p = (unsigned)_InterlockedIncrement(&s_reg_ring_pos) % REG_RING;
+        s_reg_ring[p].what = what;
+        s_reg_ring[p].old = old;
+        s_reg_ring[p].val = val;
+    }
+}
+
 static void fe_method(MCPXAPUState *d, uint32_t method, uint32_t argument)
 {
     unsigned int slot;
 
-    d->regs[NV_PAPU_FEDECMETH] = method;
-    d->regs[NV_PAPU_FEDECPARAM] = argument;
+    if (method != SE2FE_IDLE_VOICE && g_apu_stats.enabled > 0) {
+        unsigned p = s_fe_ring_pos++ % FE_RING;
+        s_fe_ring[p].method = method;
+        s_fe_ring[p].arg = argument;
+    }
+
+    /* While the FE is trapped, FEDECMETH/FEDECPARAM describe the trap and
+     * the title's ISR reads them (DirectSound: method 0x8000 = idle voice,
+     * param = the voice it then unlinks and frees). On hardware the FE is
+     * stalled until the ISR resumes it, so they cannot change underneath;
+     * here the title's own methods (and further idle voices) kept arriving
+     * and overwrote them. A trap pairing 0x8000 with the handle of a voice
+     * the title had just selected made DirectSound free a playing voice --
+     * MKSM's music, cut out of its list mid-level (plan 3.3c). */
+    bool trapped = (d->regs[NV_PAPU_FECTL] & NV_PAPU_FECTL_FEMETHMODE) ==
+                   NV_PAPU_FECTL_FEMETHMODE_TRAPPED;
+    if (!trapped) {
+        d->regs[NV_PAPU_FEDECMETH] = method;
+        d->regs[NV_PAPU_FEDECPARAM] = argument;
+    }
     unsigned int selected_handle, list;
 
     switch (method) {
@@ -214,6 +264,7 @@ static void fe_method(MCPXAPUState *d, uint32_t method, uint32_t argument)
 
     case NV1BA0_PIO_VOICE_ON: {
         selected_handle = argument & NV1BA0_PIO_VOICE_ON_HANDLE;
+        if (mcpx_apu_stats_on()) g_apu_stats.on++;
 
         bool locked = is_voice_locked(d, (uint16_t)selected_handle);
         if (!locked) voice_lock(d, (uint16_t)selected_handle, true);
@@ -326,6 +377,7 @@ static void fe_method(MCPXAPUState *d, uint32_t method, uint32_t argument)
     }
 
     case NV1BA0_PIO_VOICE_OFF:
+        if (mcpx_apu_stats_on()) g_apu_stats.off_cmd++;
         voice_off(d, (uint16_t)(argument & NV1BA0_PIO_VOICE_OFF_HANDLE));
         break;
 
@@ -505,12 +557,17 @@ static void fe_method(MCPXAPUState *d, uint32_t method, uint32_t argument)
         break;
 
     case SE2FE_IDLE_VOICE:
+        /* One trap at a time: the voice stays on its list and is reported
+         * again on a later frame, after the ISR has resumed the FE. */
+        if (trapped)
+            break;
         if (d->regs[NV_PAPU_FETFORCE1] & NV_PAPU_FETFORCE1_SE2FE_IDLE_VOICE) {
             d->regs[NV_PAPU_FECTL] &= ~NV_PAPU_FECTL_FEMETHMODE;
             d->regs[NV_PAPU_FECTL] |= NV_PAPU_FECTL_FEMETHMODE_TRAPPED;
             d->regs[NV_PAPU_FECTL] &= ~NV_PAPU_FECTL_FETRAPREASON;
             d->regs[NV_PAPU_FECTL] |= NV_PAPU_FECTL_FETRAPREASON_REQUESTED;
             d->set_irq = true;
+            mcpx_apu_reg_event(0x8000, 0, argument);
         }
         break;
 
@@ -585,8 +642,13 @@ void mcpx_apu_vp_write(void *opaque, hwaddr addr, uint64_t val,
     MCPXAPUState *d = (MCPXAPUState *)opaque;
     (void)size;
 
-    /* Dispatch known methods through fe_method */
+    /* Under the device lock, like the frame thread's own fe_method calls:
+     * the FE is one serial engine, and the two used to interleave their
+     * FEDEC writes (see fe_method). Recursive, so this is fine from the
+     * title's ISR, which the frame thread runs with the lock dropped. */
+    qemu_mutex_lock(&d->lock);
     fe_method(d, (uint32_t)addr, (uint32_t)val);
+    qemu_mutex_unlock(&d->lock);
 }
 
 /* ============================================================
@@ -809,6 +871,10 @@ static int voice_get_samples(MCPXAPUState *d, uint32_t v, float samples[][2],
         page = d->vp.ssl[v].base[ssl_index] + ssl_seg;
         count = d->vp.ssl[v].count[ssl_index];
 
+        if (mcpx_apu_stats_on()) {
+            if (count == 0) g_apu_stats.strm_empty++;
+            else            g_apu_stats.strm++;
+        }
         if (count == 0) {
             voice_set_mask(d, (uint16_t)v, NV_PAVS_VOICE_PAR_OFFSET,
                            NV_PAVS_VOICE_PAR_OFFSET_CBO, 0);
@@ -939,6 +1005,7 @@ static int voice_get_samples(MCPXAPUState *d, uint32_t v, float samples[][2],
                 int next_index = (ssl_index + 1) % 2;
                 d->vp.ssl[v].ssl_index = next_index;
                 d->vp.ssl[v].ssl_seg = 0;
+                if (mcpx_apu_stats_on()) g_apu_stats.ssl_done++;
                 set_notify_status(d, v, MCPX_HW_NOTIFIER_SSLA_DONE + ssl_index,
                                   NV1BA0_NOTIFICATION_STATUS_DONE_SUCCESS);
             }
@@ -1162,6 +1229,21 @@ static void voice_process(MCPXAPUState *d,
         dbg->vol[i] = vol[i];
     }
 
+    if (g_apu_stats.enabled > 1) {
+        struct VoiceStat *vs = &s_vstat[v];
+        vs->list = (uint8_t)voice_list;
+        vs->frames++;
+        vs->vol0 = vol[0];
+        vs->vol1 = vol[1];
+        vs->bin0 = (uint8_t)bin[0];
+        vs->bin1 = (uint8_t)bin[1];
+        vs->rate = rate;
+        for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+            vs->peak = mcpx_apu_peak_f(vs->peak, samples[i][0]);
+            vs->peak = mcpx_apu_peak_f(vs->peak, samples[i][1]);
+        }
+    }
+
     if (voice_should_mute(v)) return;
 
     /* Low-pass filter */
@@ -1241,6 +1323,67 @@ static void voice_process(MCPXAPUState *d,
  * Simplified single-threaded version (no worker threads initially)
  * ============================================================ */
 
+/* Dropped-voice check (RECOMP_APU_STATS, plan 3.3c): a voice that was on a
+ * list last frame, is on no list now and is still ACTIVE was cut out of the
+ * list without being stopped -- the music voice did this in a level. */
+static uint16_t s_walk[3][MCPX_HW_MAX_VOICES], s_prev[3][MCPX_HW_MAX_VOICES];
+static int s_walk_len[3], s_prev_len[3];
+
+static void print_list(const char *tag, int list, const uint16_t *w, int n)
+{
+    fprintf(stderr, "  %s list %d:", tag, list);
+    for (int i = 0; i < n; i++)
+        fprintf(stderr, " %u", w[i]);
+    fprintf(stderr, "\n");
+}
+
+static void check_dropped_voices(MCPXAPUState *d)
+{
+    static unsigned reports;
+    uint8_t now_on[MCPX_HW_MAX_VOICES] = {0};
+
+    for (int l = 0; l < 3; l++)
+        for (int i = 0; i < s_walk_len[l]; i++)
+            now_on[s_walk[l][i]] = 1;
+    for (int l = 0; l < 3; l++) {
+        for (int i = 0; i < s_prev_len[l]; i++) {
+            uint16_t v = s_prev[l][i];
+            if (now_on[v] || !voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
+                                             NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE))
+                continue;
+            now_on[v] = 1;   /* once per voice per frame */
+            if (reports++ >= 20)
+                continue;
+            fprintf(stderr, "[APU-DROP] active voice %u left list %d unstopped"
+                    " (FECTL=%08X FEDEC=%04X/%04X)\n", v, l,
+                    (unsigned)d->regs[NV_PAPU_FECTL],
+                    (unsigned)d->regs[NV_PAPU_FEDECMETH],
+                    (unsigned)d->regs[NV_PAPU_FEDECPARAM]);
+            print_list("before", l, s_prev[l], s_prev_len[l]);
+            print_list("after ", l, s_walk[l], s_walk_len[l]);
+            fprintf(stderr, "  FE methods, oldest first:");
+            for (unsigned k = 0; k < FE_RING; k++) {
+                unsigned p = (s_fe_ring_pos + k) % FE_RING;
+                if (s_fe_ring[p].method || s_fe_ring[p].arg)
+                    fprintf(stderr, " %X:%X", s_fe_ring[p].method,
+                            s_fe_ring[p].arg);
+            }
