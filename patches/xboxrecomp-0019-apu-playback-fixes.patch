 /* ============================================================
- * Voice resampling (simplified - no libsamplerate)
+ * Voice resampling (linear interpolation; xemu uses libsamplerate)
+ *
+ * rate is output/input, as xemu hands it to src_process: a voice's pitch
+ * is 4096 * log2(f / 48000), so 24 kHz content has rate 2 and needs one
+ * source sample per two output samples. This used to be ignored (one
+ * source sample per output sample), which played everything recorded
+ * below 48 kHz too fast and too high: MKSM's audio at double speed.
  *
- * Since libsamplerate is stubbed, we do a simple nearest-neighbor
- * resample. This gives us functional audio at the cost of quality.
+ * Source samples are fetched in batches (voice_get_samples decodes a whole
+ * ADPCM block per call) into s_rs[v].buf and carried across frames.
  * ============================================================ */
 
 static int voice_resample(MCPXAPUState *d, uint16_t v, float samples[][2],
                           int requested_num, float rate)
 {
-    /* Without libsamplerate, just fetch raw samples at native rate.
-     * Rate < 1.0 means we need more source samples than output samples.
-     * For initial functionality, just get the samples directly. */
-    int sample_count = 0;
-    while (sample_count < requested_num) {
+    double step = (rate > 0.0f) ? 1.0 / rate : 1.0;
+    if (step > RS_MAX_STEP) step = RS_MAX_STEP;
+    if (step < 1.0 / 64) step = 1.0 / 64;
+
+    float (*buf)[2] = s_rs[v].buf;
+    int need = (int)(s_rs[v].frac + step * (requested_num - 1)) + 2;
+    if (need > RS_BUF) need = RS_BUF;
+
+    /* Top up the source buffer */
+    while (s_rs[v].len < need) {
         int active = voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
                                     NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE);
         if (!active) break;
+        int count = voice_get_samples(d, v, &buf[s_rs[v].len],
+                                      need - s_rs[v].len);
+        if (count <= 0) break;   /* ended or starved: use what we have */
+        s_rs[v].len += count;
+    }
 
-        int count = voice_get_samples(d, v, &samples[sample_count],
-                                      requested_num - sample_count);
-        if (count < 0) break;
-        if (count == 0) return -1;
-        sample_count += count;
+    /* A voice that ended keeps its last sample for the final interpolation */
+    int len = s_rs[v].len;
+    int out = 0;
+    double frac = s_rs[v].frac;
+    while (out < requested_num) {
+        int i = (int)frac;
+        if (i + 1 >= len) {
+            /* Last sample of an ended voice: hold it rather than drop it */
+            if (i < len && !voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
+                                           NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE)) {
+                samples[out][0] = buf[i][0];
+                samples[out][1] = buf[i][1];
+                out++;
+                frac += step;
+            }
+            break;
+        }
+        float t = (float)(frac - i);
+        samples[out][0] = buf[i][0] + (buf[i + 1][0] - buf[i][0]) * t;
+        samples[out][1] = buf[i][1] + (buf[i + 1][1] - buf[i][1]) * t;
+        out++;
+        frac += step;
     }
-    (void)rate; /* Ignored until we add proper resampling */
-    return sample_count;
+
+    /* Drop the source samples we've moved past */
+    int drop = (int)frac;
+    if (drop > len) drop = len;
+    if (drop > 0) {
+        memmove(buf, buf + drop, (size_t)(len - drop) * sizeof(buf[0]));
+        s_rs[v].len = len - drop;
+        frac -= drop;
+    }
+    s_rs[v].frac = frac;
+
