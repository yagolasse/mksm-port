From e837a1a48c82a1d70c10cf6cf746ba4edeeaff00 Mon Sep 17 00:00:00 2001
From: Yago Lasse <yagolasse@gmail.com>
Date: Fri, 16 Oct 2026 04:12:24 -0300
Subject: [PATCH] nv2a: xbox_Nv2aVBlank sets D3D's VBlank event

D3D's BlockUntilVerticalBlank resets a notification event at miniport +
0x194 and waits for the VBlank DPC to set it. The runtime delivers no NV2A
interrupts, so the wait failed at once (or blocked for good with title
events on) and threads pacing themselves on it spun. A device model calls
xbox_Nv2aVBlank() once per emulated VBlank; it sets that event the way the
DPC would (the rest of the DPC is not reproduced). The miniport is found
like xbox_Nv2aSoftwareMethod's: the context of the ISR on the NV2A vector.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016ahYm8JBvCH5KhgtSu9Yoy
---
 src/kernel/kernel_bridge.c | 19 +++++++++++++++++++
 src/kernel/nv2a_pb_hook.h  |  5 +++++
 2 files changed, 24 insertions(+)

diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
index f776d95..cbef493 100644
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -2484,6 +2484,25 @@ int xbox_Nv2aSoftwareMethod(uint32_t param)
     return 0;
 }
 
+/* A vertical blank. On hardware the PCRTC raises the NV2A interrupt and D3D's
+ * VBlank DPC (counts it, does the flip bookkeeping, acks PCRTC_INTR) sets the
+ * notification event at miniport + 0x194, the one BlockUntilVerticalBlank
+ * resets and then waits on. The runtime delivers no NV2A interrupts, so that
+ * wait failed at once (or, with RECOMP_TITLE_KEVENTS, blocked for good) and a
+ * thread pacing itself on it spun. A device model calls this once per emulated
+ * VBlank; only the event is reproduced, not the rest of the DPC. Returns 1
+ * once D3D has connected its interrupt, else 0. */
+int xbox_Nv2aVBlank(void)
+{
+    uint32_t kint = xbox_GetConnectedInterrupt(NV2A_VECTOR);
+    uint32_t miniport = kint ? BRIDGE_MEM32(kint + 4) : 0;
+
+    if (!miniport)
+        return 0;
+    ke_set_event(miniport + 0x194u);
+    return 1;
+}
+
 /* ── MmClaimGpuInstanceMemory (ordinal 168) ───────────────
  * PVOID MmClaimGpuInstanceMemory(SIZE_T NumberOfBytes, SIZE_T *Padding)
  *
diff --git a/src/kernel/nv2a_pb_hook.h b/src/kernel/nv2a_pb_hook.h
index 7047549..4b88cff 100644
--- a/src/kernel/nv2a_pb_hook.h
+++ b/src/kernel/nv2a_pb_hook.h
@@ -31,4 +31,9 @@ void nv2a_pb_set_method_hook(nv2a_pb_method_hook_fn fn);
  * (kernel_bridge.c). Returns 1 if the method is handled. Any thread. */
 int xbox_Nv2aSoftwareMethod(uint32_t param);
 
+/* An emulated vertical blank: sets the event D3D's VBlank DPC would
+ * (BlockUntilVerticalBlank's), kernel_bridge.c. Call it once per VBlank from
+ * any thread. Returns 0 until D3D has connected its interrupt. */
+int xbox_Nv2aVBlank(void);
+
 #endif
