@@ -76,8 +77,9 @@ typedef void *(*QemuThreadFunc)(void *arg);
 static inline void qemu_thread_create(QemuThread *t, const char *name,
                                        void *(*func)(void *), void *arg,
                                        int mode) {
-    (void)name; (void)mode;
+    (void)mode;
     t->thread = CreateThread(NULL, 0, (LPTHREAD_START_ROUTINE)func, arg, 0, NULL);
+    if (t->thread) xbox_name_thread(t->thread, "%s", name);
 }
 #endif
 
diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
index 623b32f..f776d95 100644
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -29,6 +29,7 @@
 #include "guest_vmem.h"
 #include "xbox_memory_layout.h"
 #include "recomp_icall_feedback.h"
+#include "../../include/xbox/thread_name.h"
 #include <stdio.h>
 /* stdlib.h is load-bearing, not tidiness. Without it C89 implicit declaration
  * makes malloc return `int`, so bridge_spawn_thread truncated its heap pointer
@@ -513,8 +514,18 @@ static DWORD WINAPI bridge_thread_main(LPVOID param)
     return 0;
 }
 
-static HANDLE bridge_spawn_thread(recomp_func_t fn, uint32_t ctx1,
-                                  uint32_t ctx2, uint32_t stack_top)
+/* Names a guest thread after its creation call: "guest #<n> <routine>(<ctx1>)".
+ * XAPI's CreateThread passes the title's own routine as ctx1 to a common
+ * startup routine, so both are in the name. NULL = the calling thread. */
+static void bridge_name_guest_thread(HANDLE th, uint32_t routine, uint32_t ctx1)
+{
+    xbox_name_thread(th, "guest #%d 0x%08X(0x%08X)", g_thread_call_count,
+                     routine, ctx1);
+}
+
+static HANDLE bridge_spawn_thread(recomp_func_t fn, uint32_t routine,
+                                  uint32_t ctx1, uint32_t ctx2,
+                                  uint32_t stack_top)
 {
     struct bridge_thread_start *s = malloc(sizeof(*s));
     HANDLE th;
@@ -527,7 +538,10 @@ static HANDLE bridge_spawn_thread(recomp_func_t fn, uint32_t ctx1,
     /* Record the game thread so a host-tick-driven title's watchdog can sample
      * it via xbox_thread_debug_handle. Harmless for default-model titles: they
      * spawn workers too, but never read it back. See kernel_thread.c. */
-    else xbox_set_game_thread(th);
+    else {
+        bridge_name_guest_thread(th, routine, ctx1);
+        xbox_set_game_thread(th);
+    }
     return th;
 }
 
@@ -584,6 +598,7 @@ static void bridge_PsCreateSystemThreadEx(void)
         if (fn) {
             if (is_first_call) {
                 /* Main game thread: run directly, inheriting register state */
+                bridge_name_guest_thread(NULL, start_routine, start_context1);
                 g_esp -= 4; BRIDGE_MEM32(g_esp) = start_context2;
                 g_esp -= 4; BRIDGE_MEM32(g_esp) = start_context1;
                 g_esp -= 4; BRIDGE_MEM32(g_esp) = 0;
@@ -632,7 +647,7 @@ static void bridge_PsCreateSystemThreadEx(void)
                     fflush(stderr);
                     bridge_run_thread_inline(fn, start_context1, start_context2);
                 } else {
-                    HANDLE th = bridge_spawn_thread(fn, start_context1,
+                    HANDLE th = bridge_spawn_thread(fn, start_routine, start_context1,
                                                     start_context2, stack_top);
                     fprintf(stderr, "  [KERNEL] PsCreateSystemThreadEx: spawned "
                             "worker 0x%08X (ctx=0x%08X, stack top 0x%08X)\n",
@@ -2603,6 +2618,7 @@ static DWORD WINAPI kernel_timer_thread(LPVOID unused)
     int slot = xbox_worker_stack_alloc();
 
     (void)unused;
+    xbox_name_thread(NULL, "kernel timers");
     if (slot < 0) {
         fprintf(stderr, "  [KERNEL] timer thread has no worker stack; "
                         "timer DPCs will not run\n");
@@ -7951,6 +7967,7 @@ static void bridge_PsCreateSystemThread(void)
             fn = recomp_lookup_manual(start_routine);
         if (fn) {
             if (is_first_call) {
+                bridge_name_guest_thread(NULL, start_routine, start_context1);
                 g_esp -= 4; BRIDGE_MEM32(g_esp) = start_context2;
                 g_esp -= 4; BRIDGE_MEM32(g_esp) = start_context1;
                 g_esp -= 4; BRIDGE_MEM32(g_esp) = 0;
@@ -7969,7 +7986,7 @@ static void bridge_PsCreateSystemThread(void)
                 if (!stack_top) {
                     bridge_run_thread_inline(fn, start_context1, start_context2);
                 } else {
-                    HANDLE th = bridge_spawn_thread(fn, start_context1,
+                    HANDLE th = bridge_spawn_thread(fn, start_routine, start_context1,
                                                     start_context2, stack_top);
                     if (xbox_handle_ptr && th)
                         bridge_write_handle(xbox_handle_ptr, th);
