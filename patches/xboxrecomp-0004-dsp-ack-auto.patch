From 1fadb0161966391626bc110af5bb935e5ab09f03 Mon Sep 17 00:00:00 2001
From: Yago Lasse <yagolasse@gmail.com>
Date: Wed, 14 Oct 2026 19:27:35 -0300
Subject: [PATCH] apu_dsp: RECOMP_APU_DSP_ACK=auto finds the doorbell from
 GPSADDR

The DirectSound command doorbell is GP scratch page 0 + 0x810. GPSADDR
points at the GP scratch scatter-gather table; its first entry is that
page. Both are physical, reached here through the contiguous arena
(0x80000000 + P). Re-read every APU frame, so the ack follows the
allocation when heap reclaim or a different path moves it, instead of
a hard-coded address per run configuration.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BsjokU5AonJ5uAaxukRBuF
---
 src/apu/apu_dsp.c | 79 ++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 72 insertions(+), 7 deletions(-)

diff --git a/src/apu/apu_dsp.c b/src/apu/apu_dsp.c
index 7156be9..c401393 100644
--- a/src/apu/apu_dsp.c
+++ b/src/apu/apu_dsp.c
@@ -45,16 +45,24 @@
  * the title reads back will still be wrong. The real fix is DSP56300 emulation
  * in the GP/EP; this exists so audio init stops blocking everything behind it.
  *
- * The address is not derivable from the APU registers: GPSADDR/GPFADDR/
- * EPSADDR/EPFADDR point at the DSP's own scratch and frame memory, while the
- * command block is a DirectSound heap allocation. On Wreckless the registers
- * read 0x01504000 / 0x014EC000 / 0x0151C000 / 0x014F0000 and the doorbell is at
- * 0x014F8810 -- inside none of them. So it has to be observed: run with
- * RECOMP_WATCHDOG_SECS and the spin shows up as ebx plus the poll offset.
+ * The doorbell is not inside the ranges the APU registers name: on Wreckless
+ * GPSADDR/GPFADDR/EPSADDR/EPFADDR read 0x01504000 / 0x014EC000 / 0x0151C000 /
+ * 0x014F0000 and the doorbell is at 0x014F8810. A fixed address can be
+ * observed (run with RECOMP_WATCHDOG_SECS; the spin shows up as ebx plus the
+ * poll offset), but it moves whenever the title's allocation order changes.
+ *
+ * RECOMP_APU_DSP_ACK=auto derives it instead: GPSADDR is the GP scratch
+ * scatter-gather table (8-byte entries, page address in the first dword, as
+ * in xemu's scratch_rw), and the doorbell is scratch page 0 + 0x810. Re-read
+ * every frame and logged on change. Fixed addresses can follow after a comma.
+ * Found on MK: Shaolin Monks; on another title, check the address it prints
+ * against the spin's ebx before relying on it.
  */
 #define APU_DSP_ACK_MAX 8
+#define APU_DSP_DOORBELL_SCRATCH_OFF 0x810
 static uint32_t s_dsp_ack[APU_DSP_ACK_MAX];
 static int s_dsp_ack_count = -1;
+static int s_dsp_ack_auto;
 
 static void dsp_ack_init(void)
 {
@@ -67,7 +75,15 @@ static void dsp_ack_init(void)
     strncpy(buf, spec, sizeof buf - 1);
     buf[sizeof buf - 1] = 0;
     for (p = buf; *p && s_dsp_ack_count < APU_DSP_ACK_MAX; ) {
-        unsigned long v = strtoul(p, &end, 0);
+        unsigned long v;
+        if (_strnicmp(p, "auto", 4) == 0) {
+            s_dsp_ack_auto = 1;
+            p += 4;
+            if (*p == ',')
+                p++;
+            continue;
+        }
+        v = strtoul(p, &end, 0);
         if (end == p)
             break;
         if (v)
@@ -77,6 +93,44 @@ static void dsp_ack_init(void)
     if (s_dsp_ack_count)
         fprintf(stderr, "[APU] DSP doorbell ack: %d address(es), first 0x%08X\n",
                 s_dsp_ack_count, s_dsp_ack[0]);
+    if (s_dsp_ack_auto)
+        fprintf(stderr, "[APU] DSP doorbell ack: auto (GP scratch page 0 + 0x%X)\n",
+                APU_DSP_DOORBELL_SCRATCH_OFF);
+}
+
+/* GPSADDR and the SGE entries hold physical addresses (the title wrote them
+ * through MmGetPhysicalAddress), and here physical RAM is only reachable
+ * through the contiguous arena, physical P at 0x80000000 + P: the low VA with
+ * the same number is other memory (kernel/kernel.h, XBOX_CONTIG_BASE).
+ * Measured on MK: Shaolin Monks: GPSADDR 0x0355C000 reads as zero at VA
+ * 0x0355C000 and holds the scratch page 0x03550000 at 0x8355C000. */
+#define DSP_CONTIG_BASE 0x80000000u
+#define DSP_CONTIG_SIZE (64u * 1024u * 1024u)
+static uint32_t dsp_phys_to_va(uint32_t phys)
+{
+    return phys < DSP_CONTIG_SIZE ? DSP_CONTIG_BASE + phys : phys;
+}
+
+/* The doorbell's address from the GP scratch SGE table, 0 while the table
+ * isn't set up. Logs each new value. */
+static uint32_t dsp_ack_auto_addr(MCPXAPUState *d)
+{
+    static uint32_t last;
+    uint32_t sge = qatomic_read(&d->regs[NV_PAPU_GPSADDR]);
+    uint32_t page, addr;
+
+    if (!sge)
+        return 0;
+    page = *(uint32_t *)(d->ram_ptr + dsp_phys_to_va(sge)) & 0xFFFFF000u;
+    if (!page)
+        return 0;
+    addr = dsp_phys_to_va(page) + APU_DSP_DOORBELL_SCRATCH_OFF;
+    if (addr != last) {
+        fprintf(stderr, "[APU] DSP doorbell auto: GPSADDR 0x%08X -> scratch page"
+                        " 0x%08X, doorbell 0x%08X\n", sge, page, addr);
+        last = addr;
+    }
+    return addr;
 }
 
 /* SUM EVERY MIXBIN THE GUEST ROUTED TO, NOT JUST THE FIRST TWO.
@@ -102,6 +156,17 @@ void mcpx_apu_dsp_ack_poll(MCPXAPUState *d)
         dsp_ack_init();
     if (!d->ram_ptr)
         return;
+    if (s_dsp_ack_auto) {
+        uint32_t addr = dsp_ack_auto_addr(d);
+        uint32_t *slot = (uint32_t *)(d->ram_ptr + addr);
+        if (addr && *slot) {
+            static int shown;
+            if (shown++ < 3)
+                fprintf(stderr, "[APU] DSP doorbell 0x%08X: command 0x%08X"
+                                " acknowledged\n", addr, *slot);
+            *slot = 0;
+        }
+    }
     for (i = 0; i < s_dsp_ack_count; i++) {
         uint32_t *slot = (uint32_t *)(d->ram_ptr + s_dsp_ack[i]);
         if (*slot) {
-- 
