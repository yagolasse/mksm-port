 src/usb/ohci.c                      | 31 +++++++--
 tests/mmio_decode/CMakeLists.txt    |  1 +
 tests/mmio_decode/test_main.c       | 98 +++++++++++++++++++++-------
 tests/usb_ohci_posix/CMakeLists.txt |  5 +-
 tests/usb_ohci_posix/test_main.c    |  7 +-
 8 files changed, 259 insertions(+), 59 deletions(-)

diff --git a/src/apu/apu_mmio_hook.c b/src/apu/apu_mmio_hook.c
index f4f8a82..335451f 100644
--- a/src/apu/apu_mmio_hook.c
+++ b/src/apu/apu_mmio_hook.c
@@ -2,9 +2,9 @@
  * MCPX APU MMIO Hook - trapped APU register access
  *
  * Decodes the faulting instruction with the shared trapped-MMIO decoders
- * (src/platform/mmio_decode.h on x86-64 under a VEH, mmio_decode_a64.h on
- * POSIX arm64 under SIGBUS/SIGSEGV) and routes reads/writes through the MCPX
- * APU register handlers.
+ * (src/platform/mmio_decode.h on x86-64 under a VEH or a Linux SIGSEGV
+ * handler, mmio_decode_a64.h on POSIX arm64 under SIGBUS/SIGSEGV) and routes
+ * reads/writes through the MCPX APU register handlers.
  */
 
 #include "apu.h"
@@ -17,9 +17,9 @@
  * platform's MMIO hook is active, so define it before the #if guard. */
 MCPXAPUState *g_apu_state = NULL;
 
-/* Windows: a VEH hands over the CONTEXT. POSIX arm64: a SIGBUS/SIGSEGV
- * handler hands over the ucontext (apu_hook_handle_mmio_posix, at the end).
- * x86-64 Linux has no trap yet. */
+/* Windows: a VEH hands over the CONTEXT. POSIX (arm64, Linux x86-64): a
+ * SIGBUS/SIGSEGV handler hands over the ucontext (apu_hook_handle_mmio_posix,
+ * at the end). */
 #if defined(_WIN32)
 #include <windows.h>
 #include "../platform/mmio_decode.h"
@@ -124,12 +124,19 @@ bool apu_hook_handle_mmio(PCONTEXT ctx, uintptr_t fault_addr,
 
 #endif /* _WIN32 */
 
-#if !defined(_WIN32) && defined(__aarch64__)
-/* POSIX arm64: the same hook over sigaction + ucontext, with the A64 decoder
- * (src/platform/mmio_decode_a64.h). The host's fault handler reaches it
- * through xbox_PosixMmioFault before it reports a crash. */
+#if !defined(_WIN32) && (defined(__aarch64__) \
+                         || (defined(__x86_64__) && defined(__linux__)))
+/* POSIX: the same hook over sigaction + ucontext, with the A64 decoder
+ * (src/platform/mmio_decode_a64.h) on arm64 and the x86-64 one
+ * (src/platform/mmio_decode.h, through its ucontext bridge) on Linux x86-64.
+ * The host's fault handler reaches it through xbox_PosixMmioFault before it
+ * reports a crash. */
 #include <signal.h>
+#if defined(__aarch64__)
 #include "../platform/mmio_decode_a64.h"
+#else
+#include "../platform/mmio_decode.h"
+#endif
 
 #define APU_MMIO_BASE  0xFE800000u
 #define APU_MMIO_SIZE  0x00080000u
@@ -137,8 +144,8 @@ bool apu_hook_handle_mmio(PCONTEXT ctx, uintptr_t fault_addr,
 static int g_apu_mmio_decode_fail;
 
 /* The model's registers are 32-bit and its read/write ignore the size, so an
- * 8-byte access (ldr/str x, a d register, each half of a q register) is two
- * 4-byte accesses here, as on Windows. */
+ * 8-byte access (ldr/str x, a d register, each half of a q register; a REX.W
+ * mov on x86-64) is two 4-byte accesses here, as on Windows. */
 static uint64_t apu_mmio_rd(void *dev, uint32_t off, int size)
 {
     if (size == 8) {
@@ -171,16 +178,28 @@ bool apu_hook_handle_mmio_posix(void *ucv, uintptr_t fault_addr,
     (void)fault_addr; (void)is_write;
     if (!g_apu_state || off >= APU_MMIO_SIZE)
         return false;
+#if defined(__aarch64__)
     if (mmio_emulate_a64(uc, off, g_apu_state, apu_mmio_rd, apu_mmio_wr))
         return true;
+#else
+    if (mmio_emulate_ucontext(uc, off, g_apu_state, apu_mmio_rd, apu_mmio_wr))
+        return true;
+#endif
     g_apu_mmio_decode_fail++;
     /* stdio in a signal handler is not async-signal-safe. The process is
      * about to die of this fault anyway, and the line is what says why;
      * capped at 20, as on Windows. */
-    if (g_apu_mmio_decode_fail <= 20)
+    if (g_apu_mmio_decode_fail <= 20) {
+#if defined(__aarch64__)
         fprintf(stderr, "[APU] MMIO decode fail at PC=%p insn=%08X offset=0x%X\n",
                 (void *)(uintptr_t)A64_CTX_PC(uc),
                 *(const uint32_t *)(uintptr_t)A64_CTX_PC(uc), off);
+#else
+        const uint8_t *ip = mmio_ucontext_ip(uc);
+        fprintf(stderr, "[APU] MMIO decode fail at RIP=%p offset=0x%X: %02X %02X %02X %02X %02X %02X\n",
+                (const void *)ip, off, ip[0], ip[1], ip[2], ip[3], ip[4], ip[5]);
+#endif
+    }
     return false;
 }
 #endif
diff --git a/src/kernel/xbox_memory_layout.c b/src/kernel/xbox_memory_layout.c
