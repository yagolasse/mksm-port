From 0d90f6a8786e59d4f2e1c4906562388a463f81d9 Mon Sep 17 00:00:00 2001
From: Yago Lasse <yagolasse@gmail.com>
Date: Wed, 14 Oct 2026 13:51:33 -0300
Subject: [PATCH] fb_present: closing the framebuffer window ends the process

WM_CLOSE only cleared s_fb_running, so the window thread exited and the
next xbox_FramebufferWindowStart() (AvSetDisplayMode, pushbuffer surface
setup) opened a new window. Flush stdio and TerminateProcess instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/video/fb_present.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/video/fb_present.c b/src/video/fb_present.c
index b26edfe..5e9d68a 100644
--- a/src/video/fb_present.c
+++ b/src/video/fb_present.c
@@ -149,6 +149,17 @@ static LRESULT CALLBACK fb_wndproc(HWND h, UINT m, WPARAM w, LPARAM l)
 {
     switch (m) {
     case WM_CLOSE:
+        /* Closing the window quits the title. Only clearing s_fb_running
+         * here let the next AvSetDisplayMode / surface setup call
+         * xbox_FramebufferWindowStart() and open a fresh window. Terminate
+         * rather than ExitProcess: guest threads print all the time, and
+         * one killed while holding a CRT stream lock would hang the exit
+         * flush. Flush our own output first. */
+        fprintf(stderr, "  [FBWIN] window closed, exiting\n");
+        fflush(stdout);
+        fflush(stderr);
+        TerminateProcess(GetCurrentProcess(), 0);
+        return 0;
     case WM_DESTROY:
         InterlockedExchange(&s_fb_running, 0);
         return 0;
-- 
2.53.0.windows.2

