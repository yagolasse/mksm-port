From 336975a701868c38b935746474133857e2f98ba9 Mon Sep 17 00:00:00 2001
From: Yago Lasse <yagolasse@gmail.com>
Date: Thu, 15 Oct 2026 12:45:45 -0300
Subject: [PATCH] nv2a: follow the pushbuffer ring's JUMP instead of guessing
 its bounds

When DMA_PUT wrapped, the scan used the lowest and highest PUT seen as the
ring's bounds and walked [old PUT, highest PUT) + [lowest PUT, new PUT).
Everything the title wrote after its last PUT before the wrap JUMP (a few
hundred bytes to ~1.5 KB, the tail of a frame, every wrap) and the first
words at the ring start were never executed. The software executor
tolerated it; an external PGRAPH (the method hook) sees a draw whose END
never came and asserts.

nv2a_pb_scan_ring walks the way the GPU does: from GET (the old PUT)
through any JUMP up to the new PUT. A walk that never meets PUT is logged.
RECOMP_PB_WRAP_TRACE now logs the JUMP and how many bytes the old bounds
would have skipped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/nv2a_pb_scan.c       | 58 +++++++++++++++++++++++++++++----
 src/kernel/xbox_memory_layout.c | 54 ++++++++++++++++--------------
 2 files changed, 82 insertions(+), 30 deletions(-)

diff --git a/src/kernel/nv2a_pb_scan.c b/src/kernel/nv2a_pb_scan.c
index 65bbedb..bfea616 100644
--- a/src/kernel/nv2a_pb_scan.c
+++ b/src/kernel/nv2a_pb_scan.c
@@ -162,14 +162,20 @@ void nv2a_pb_scan_report(void)
  * geometry it submits inline (environment maps, the HUD) drew fine.
  * The NV2A has one level of subroutine, so a CALL inside a call is not
  * followed. Addresses are physical, like PUT's, and reach guest memory the
- * same way: through the contiguous window. */
-static uint32_t pb_walk(uint32_t va, uint32_t end_va, int in_call,
+ * same way: through the contiguous window.
+ *
+ * With `ring` set the walk is the GPU's own: it follows the main ring's JUMPs
+ * and stops exactly at end_va (PUT), wherever that is after the jump. The last
+ * JUMP followed is kept for the wrap trace. */
+uint32_t nv2a_pb_ring_jump_from, nv2a_pb_ring_jump_to;
+
+static uint32_t pb_walk(uint32_t va, uint32_t end_va, int in_call, int ring,
                         uint32_t *jumps, uint32_t *unknown)
 {
     const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
     uint32_t words = 0;
 
-    while (va < end_va && words < 0x100000u) {
+    while ((ring ? va != end_va : va < end_va) && words < 0x100000u) {
         uint32_t w = *(const uint32_t *)(mem + va);
         va += 4;
         words++;
@@ -178,6 +184,12 @@ static uint32_t pb_walk(uint32_t va, uint32_t end_va, int in_call,
             uint32_t target = (w & 3u) == 1u ? (w & 0xFFFFFFFCu)
                                              : (w & 0x1FFFFFFCu);
             (*jumps)++;
+            if (ring) {
+                nv2a_pb_ring_jump_from = va - 4;
+                va = XBOX_CONTIG_BASE | (target & 0x0FFFFFFFu);
+                nv2a_pb_ring_jump_to = va;
+                continue;
+            }
             if (!in_call)
                 break;                        /* the ring: a jump ends it */
             va = XBOX_CONTIG_BASE | (target & 0x0FFFFFFFu);
@@ -193,7 +205,7 @@ static uint32_t pb_walk(uint32_t va, uint32_t end_va, int in_call,
             if (!in_call) {
                 uint32_t sub = XBOX_CONTIG_BASE | ((w & 0xFFFFFFFCu) & 0x0FFFFFFFu);
                 s_tot_calls++;
-                words += pb_walk(sub, sub + 0x400000u, 1, jumps, unknown);
+                words += pb_walk(sub, sub + 0x400000u, 1, 0, jumps, unknown);
             }
             continue;
         }
@@ -203,7 +215,7 @@ static uint32_t pb_walk(uint32_t va, uint32_t end_va, int in_call,
             uint32_t method =  w & 0x1FFCu;
             int noninc = (w & 0xE0000000u) == 0x40000000u;
 
-            for (uint32_t i = 0; i < count && va < end_va; i++) {
+            for (uint32_t i = 0; i < count && (ring ? va != end_va : va < end_va); i++) {
                 uint32_t m = noninc ? method : method + i * 4;
                 note(subch, m);
                 /* Same walk, two consumers: the survey counts, the executor
@@ -236,7 +248,41 @@ void nv2a_pb_scan(uint32_t start_va, uint32_t end_va)
     if (end_va - start_va > 0x400000u)        /* a sane single-frame bound */
         end_va = start_va + 0x400000u;
 
-    words = pb_walk(start_va, end_va, 0, &jumps, &unknown);
+    words = pb_walk(start_va, end_va, 0, 0, &jumps, &unknown);
+
+    s_tot_words += words;
+    s_tot_unknown += unknown;
+    s_tot_jumps += jumps;
+    s_tot_segments++;
+}
+
+/* What the GPU consumes between two PUTs: from the old PUT (where GET is) to
+ * the new one, through the JUMP at the end of the ring when it wrapped. The
+ * ring's bounds come from the stream itself, so nothing written before the
+ * JUMP is skipped. */
+void nv2a_pb_scan_ring(uint32_t get_va, uint32_t put_va)
+{
+    uint32_t words, jumps = 0, unknown = 0;
+
+    if (s_exec_enabled < 0)
+        s_exec_enabled = getenv("RECOMP_PB_EXEC") != NULL;
+    static int scan = -1;
+    if (scan < 0)
+        scan = getenv("RECOMP_PB_SCAN") != NULL;
+    nv2a_pb_ring_jump_from = nv2a_pb_ring_jump_to = 0;
+    if (!(scan || s_exec_enabled) || get_va == put_va)
+        return;
+
+    words = pb_walk(get_va, put_va, 0, 1, &jumps, &unknown);
+    if (words >= 0x100000u) {
+        /* Never met PUT: no JUMP where the stream should have wrapped, so
+         * this walked stale memory. Loud, because it means the ring isn't
+         * shaped the way this assumes. */
+        static unsigned lost;
+        if (lost++ < 8)
+            fprintf(stderr, "[PB] ring walk 0x%08X -> 0x%08X never reached PUT "
+                    "(%u words, %u jumps)\n", get_va, put_va, words, jumps);
+    }
 
     s_tot_words += words;
     s_tot_unknown += unknown;
diff --git a/src/kernel/xbox_memory_layout.c b/src/kernel/xbox_memory_layout.c
index 093093e..63f8771 100644
--- a/src/kernel/xbox_memory_layout.c
+++ b/src/kernel/xbox_memory_layout.c
@@ -953,36 +953,42 @@ static DWORD WINAPI nv2a_ack_thread(LPVOID param)
                      * OR-ing its base is the documented round trip, not a
                      * guess. */
                     /* The pushbuffer is a ring, so PUT coming back below
-                     * where it was is a wrap, not a rewind. Scanning only
-                     * forward segments dropped everything written across
-                     * the seam -- one whole submission each time round.
+                     * where it was is a wrap, not a rewind: D3D writes a JUMP
+                     * at the end of the ring and carries on from its start.
                      *
-                     * The ring's bounds are not published anywhere this
-                     * code can read, so they are learned: the lowest and
-                     * highest PUT seen bracket it. That is approximate on
-                     * the first lap and exact afterwards, and scanning a
-                     * little short of the true end costs the same commands
-                     * that were being lost anyway. */
+                     * This used to learn the ring's bounds from the lowest and
+                     * highest PUT seen and scan [old PUT, highest PUT) plus
+                     * [lowest PUT, new PUT). Whatever the title wrote after its
+                     * last PUT before the JUMP -- usually the tail of a frame --
+                     * was never executed, and the next segment could start in
+                     * the middle of a draw. The walk now follows the stream the
+                     * way the GPU does: from GET through the JUMP to PUT.
+                     * RECOMP_PB_WRAP_TRACE logs the first wraps with how many
+                     * bytes the old bounds would have skipped. */
+                    extern void nv2a_pb_scan_ring(uint32_t, uint32_t);
+                    extern uint32_t nv2a_pb_ring_jump_from, nv2a_pb_ring_jump_to;
                     static uint32_t put_lo, put_hi;
+                    uint32_t old_hi = put_hi, old_lo = put_lo;
                     if (!put_lo || put < put_lo) put_lo = put;
                     if (put > put_hi) put_hi = put;
-                    if (last_put && put > last_put) {
-                        nv2a_pb_scan(XBOX_CONTIG_BASE | (last_put & 0x0FFFFFFFu),
-                                     XBOX_CONTIG_BASE | (put      & 0x0FFFFFFFu));
-                    } else if (last_put && put < last_put) {
-                        if (put_hi > last_put)
-                            nv2a_pb_scan(
-                                XBOX_CONTIG_BASE | (last_put & 0x0FFFFFFFu),
-                                XBOX_CONTIG_BASE | (put_hi   & 0x0FFFFFFFu));
-                        if (put > put_lo)
-                            nv2a_pb_scan(
-                                XBOX_CONTIG_BASE | (put_lo & 0x0FFFFFFFu),
-                                XBOX_CONTIG_BASE | (put    & 0x0FFFFFFFu));
-                        if (getenv("RECOMP_PB_WRAP_TRACE")) {
+                    if (last_put && put != last_put) {
+                        nv2a_pb_scan_ring(XBOX_CONTIG_BASE | (last_put & 0x0FFFFFFFu),
+                                          XBOX_CONTIG_BASE | (put      & 0x0FFFFFFFu));
+                        if (nv2a_pb_ring_jump_from && getenv("RECOMP_PB_WRAP_TRACE")) {
                             static unsigned wraps;
-                            if (wraps++ < 8)
+                            static uint64_t skipped_total;
+                            uint32_t from = nv2a_pb_ring_jump_from & 0x0FFFFFFFu;
+                            uint32_t to = nv2a_pb_ring_jump_to & 0x0FFFFFFFu;
+                            uint32_t hi = old_hi > last_put ? old_hi : last_put;
+                            uint32_t skipped = (from > hi ? from - hi : 0) +
+                                               (old_lo > to ? old_lo - to : 0);
+                            skipped_total += skipped;
+                            if (wraps++ < 16)
                                 fprintf(stderr, "  [NV2A] pushbuffer wrapped "
-                                        "(0x%08X -> 0x%08X)\n", last_put, put);
+                                        "(0x%08X -> 0x%08X, JUMP at 0x%08X -> 0x%08X): "
+                                        "old bounds skipped %u bytes (%llu so far)\n",
+                                        last_put, put, from, to, skipped,
+                                        (unsigned long long)skipped_total);
                         }
                     }
                     /* Periodic, because what the title submits at init is not
-- 
2.53.0.windows.2

