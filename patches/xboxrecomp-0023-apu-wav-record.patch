From a6df6dc21912e18d76a08a72ecd9767f3e558645 Mon Sep 17 00:00:00 2001
From: Yago Lasse <yagolasse@gmail.com>
Date: Thu, 15 Oct 2026 21:20:56 -0300
Subject: [PATCH] apu: RECOMP_APU_WAV records the output blocks to a WAV file

Every block handed to XAudio2 (before RECOMP_APU_VOLUME, so a muted run
still records) is appended to a 48 kHz stereo 16-bit WAV. The header is
rewritten about once a second so a killed process leaves a readable file.
For finding audio glitches offline instead of by ear.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016ahYm8JBvCH5KhgtSu9Yoy
---
 src/apu/apu_core.c | 54 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/src/apu/apu_core.c b/src/apu/apu_core.c
index 8f44bc0..4e637a4 100644
--- a/src/apu/apu_core.c
+++ b/src/apu/apu_core.c
@@ -561,6 +561,59 @@ static int monitor_block_peak(int16_t buf[][2], int n, int peak)
     return peak;
 }
 
+/* RECOMP_APU_WAV=<path>: every output block, as handed to XAudio2 (before
+ * RECOMP_APU_VOLUME, so a muted run still records), appended to a 48 kHz
+ * stereo 16-bit WAV. The header sizes are rewritten about once a second, so
+ * the file stays readable when the process is killed. */
+static FILE *s_wav;
+static uint32_t s_wav_bytes;
+static int s_wav_state;   /* 0 = env not read, 1 = writing, -1 = off */
+
+static void wav_put32(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);
+    p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+}
+
+static void wav_header(void)
+{
+    uint8_t h[44] = { 'R','I','F','F', 0,0,0,0, 'W','A','V','E',
+                      'f','m','t',' ', 16,0,0,0, 1,0, 2,0,
+                      0,0,0,0, 0,0,0,0, 4,0, 16,0,
+                      'd','a','t','a', 0,0,0,0 };
+    wav_put32(h + 4, 36 + s_wav_bytes);
+    wav_put32(h + 24, 48000);
+    wav_put32(h + 28, 48000 * 4);
+    wav_put32(h + 40, s_wav_bytes);
+    fseek(s_wav, 0, SEEK_SET);
+    fwrite(h, 1, sizeof(h), s_wav);
+    fseek(s_wav, 0, SEEK_END);
+}
+
+static void wav_write_block(int16_t block[][2], int n)
+{
+    if (!s_wav_state) {
+        const char *p = getenv("RECOMP_APU_WAV");
+        s_wav_state = -1;
+        if (p && *p) {
+            s_wav = fopen(p, "wb");
+            if (s_wav) {
+                s_wav_state = 1;
+                wav_header();
+                fprintf(stderr, "[APU] recording output to %s\n", p);
+            } else {
+                fprintf(stderr, "[APU] RECOMP_APU_WAV: cannot open %s\n", p);
+            }
+        }
+    }
+    if (s_wav_state != 1 || s_wav_bytes > 0x7FF00000u)
+        return;
+    fwrite(block, 4, n, s_wav);
+    s_wav_bytes += (uint32_t)n * 4;
+    if (!(s_wav_bytes % (188 * 1024)))   /* 188 blocks of 256 x 4 bytes */
+        wav_header();
+}
+
 /* Called once per se_frame (or monitor-only frame); sends one 256-sample
  * block every 8th, which throttle() paces to real time (EP_FRAME_US). */
 void mcpx_apu_monitor_frame(MCPXAPUState *d)
@@ -579,6 +632,7 @@ void mcpx_apu_monitor_frame(MCPXAPUState *d)
     if (mcpx_apu_stats_on())
         g_apu_stats.out_peak = monitor_block_peak(block, MIXER_FRAME_SAMPLES,
                                                   g_apu_stats.out_peak);
+    wav_write_block(block, MIXER_FRAME_SAMPLES);
 
     /* XAudio2 path: one buffer per block */
     if (xa2_is_active()) {
-- 
