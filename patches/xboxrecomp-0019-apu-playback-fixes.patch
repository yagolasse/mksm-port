+        /* The software mixer and test tone need continuous frame delivery
+         * regardless of APU register state; the VP/DSP pipeline (se_frame)
+         * only runs when registers allow it. */
+        throttle(d);
 
         if (apu_active && !g_test_tone.active) {
             /* Full pipeline: VP voices → DSP → monitor → waveOut */
