From 5b5bf0063046c8d28dd3f1412db77fe779c7b1a0 Mon Sep 17 00:00:00 2001
From: Yago Lasse <yagolasse@gmail.com>
Date: Thu, 15 Oct 2026 15:44:10 -0300
Subject: [PATCH] nv2a: count pushbuffer methods only when the survey is on

note() searches the method inventory linearly for every method word. It ran under RECOMP_PB_EXEC alone, where nothing reads the inventory, and was a third of the executor thread's time in a busy 3D scene. It now runs only with RECOMP_PB_SCAN.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/nv2a_pb_scan.c | 21 ++++++++++++---------
 1 file changed, 12 insertions(+), 9 deletions(-)

diff --git a/src/kernel/nv2a_pb_scan.c b/src/kernel/nv2a_pb_scan.c
index bf23ef6..0b2ec5d 100644
--- a/src/kernel/nv2a_pb_scan.c
+++ b/src/kernel/nv2a_pb_scan.c
@@ -53,6 +53,10 @@ static uint32_t s_tot_calls;
 extern void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param);
 extern void nv2a_pb_exec_report(void);
 static int s_exec_enabled = -1;
+/* The survey proper (note() + the report) is RECOMP_PB_SCAN only. note() is a
+ * linear search per method word: run unconditionally under the executor it was
+ * a third of the GPU thread's time in a level. */
+static int s_scan = -1;
 
 static void note(uint32_t subch, uint32_t method)
 {
@@ -246,7 +250,8 @@ static uint32_t pb_walk(uint32_t va, uint32_t end_va, int in_call, int ring,
 
             for (uint32_t i = 0; i < count && (ring ? va != end_va : va < end_va); i++) {
                 uint32_t m = noninc ? method : method + i * 4;
-                note(subch, m);
+                if (s_scan)
+                    note(subch, m);
                 /* Same walk, two consumers: the survey counts, the executor
                  * acts. Keeping them on one decode means they can never
                  * disagree about what the stream said. */
@@ -269,10 +274,9 @@ void nv2a_pb_scan(uint32_t start_va, uint32_t end_va)
 
     if (s_exec_enabled < 0)
         s_exec_enabled = getenv("RECOMP_PB_EXEC") != NULL;
-    static int scan = -1;
-    if (scan < 0)
-        scan = getenv("RECOMP_PB_SCAN") != NULL;
-    if (!(scan || s_exec_enabled) || end_va <= start_va)
+    if (s_scan < 0)
+        s_scan = getenv("RECOMP_PB_SCAN") != NULL;
+    if (!(s_scan || s_exec_enabled) || end_va <= start_va)
         return;
     if (end_va - start_va > 0x400000u)        /* a sane single-frame bound */
         end_va = start_va + 0x400000u;
@@ -295,11 +299,10 @@ void nv2a_pb_scan_ring(uint32_t get_va, uint32_t put_va)
 
     if (s_exec_enabled < 0)
         s_exec_enabled = getenv("RECOMP_PB_EXEC") != NULL;
-    static int scan = -1;
-    if (scan < 0)
-        scan = getenv("RECOMP_PB_SCAN") != NULL;
+    if (s_scan < 0)
+        s_scan = getenv("RECOMP_PB_SCAN") != NULL;
     nv2a_pb_ring_jump_from = nv2a_pb_ring_jump_to = 0;
-    if (!(scan || s_exec_enabled) || get_va == put_va)
+    if (!(s_scan || s_exec_enabled) || get_va == put_va)
         return;
 
     words = pb_walk(get_va, put_va, 0, 1, &jumps, &unknown);
-- 
