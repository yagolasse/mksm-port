index d41bbae..74c30ad 100644
--- a/src/apu/apu_core.c
+++ b/src/apu/apu_core.c
@@ -92,6 +92,78 @@ uint8_t *mcpx_apu_phys(uint64_t addr)
     return g_apu_ram_ptr + (a & 0x03FFFFFFu);
 }
 
+/* Sample data (voice SGE pages, stream segments). Same as mcpx_apu_phys,
+ * plus the case it can't tell apart: MmGetPhysicalAddress hands a heap
+ * address back unchanged, and once more than XBOX_HEAP_BASE bytes of
+ * contiguous memory are allocated, the same number is also a contiguous
+ * physical address. On hardware there is one RAM; here the window is
+ * separate storage, so one of the two readings is someone else's bytes.
+ * mcpx_apu_phys picks the window, which played textures as noise for a
+ * title that keeps its sound banks in heap memory.
+ *
+ * Decided per page: an address the heap has handed out (and not freed) is
+ * heap RAM, anything else the window. The heap lookup walks its block
+ * table, so the answer is cached per 4 KB page and the cache is dropped
+ * every frame (mcpx_apu_data_cache_reset). RECOMP_APU_DATA_HEAP=0 forces the
+ * window (the old behaviour), =1 forces RAM, for A/B. RECOMP_APU_STATS counts
+ * each class. */
+static int s_data_heap = -2;   /* -2 = env not read, -1 = by heap ownership */
+
+#define DATA_CACHE_SIZE 256
+static struct { uint32_t page; uint8_t valid, heap; } s_data_cache[DATA_CACHE_SIZE];
+
+void mcpx_apu_data_cache_reset(void)
+{
+    memset(s_data_cache, 0, sizeof(s_data_cache));
+}
+
+static int data_page_is_heap(uint32_t a)
+{
+    uint32_t page = a >> 12;
+    unsigned slot = page % DATA_CACHE_SIZE;
+
+    if (!s_data_cache[slot].valid || s_data_cache[slot].page != page) {
+        s_data_cache[slot].page = page;
+        s_data_cache[slot].valid = 1;
+        s_data_cache[slot].heap = xbox_HeapBlockSize(a) != 0;
+    }
+    return s_data_cache[slot].heap;
+}
+
+uint8_t *mcpx_apu_data_phys(uint64_t addr)
+{
+    uint32_t a = (uint32_t)addr & 0x0FFFFFFFu;
+    int stats = mcpx_apu_stats_on();
+
+    if (a >= g_xbox_image_lo && a < g_xbox_image_hi) {
+        if (stats) g_apu_stats.data_img++;
+        return g_apu_ram_ptr + a;
+    }
+    if (a < xbox_ContiguousAllocatedBytes()) {
+        int heap;
+        if (a < XBOX_HEAP_BASE) {
+            if (stats) g_apu_stats.data_win++;
+            return g_apu_ram_ptr + 0x80000000u + a;
+        }
+        if (s_data_heap == -2) {
+            const char *e = getenv("RECOMP_APU_DATA_HEAP");
+            s_data_heap = (e && *e) ? (atoi(e) != 0) : -1;
+        }
+        heap = s_data_heap >= 0 ? s_data_heap : data_page_is_heap(a);
+        if (stats) {
+            if (heap) g_apu_stats.amb_heap++;
+            else      g_apu_stats.amb_win++;
+            if (a < g_apu_stats.amb_lo || !g_apu_stats.amb_lo)
+                g_apu_stats.amb_lo = a;
+            if (a > g_apu_stats.amb_hi) g_apu_stats.amb_hi = a;
+        }
+        return heap ? g_apu_ram_ptr + (a & 0x03FFFFFFu)
+                    : g_apu_ram_ptr + 0x80000000u + a;
+    }
+    if (stats) g_apu_stats.data_ram++;
+    return g_apu_ram_ptr + (a & 0x03FFFFFFu);
+}
