     mcpx_debug_end_frame();
 }
 
+/* One [APU-STATS] line per second (RECOMP_APU_STATS=1), then reset. */
+static void mcpx_apu_stats_tick(MCPXAPUState *d)
+{
+    struct McpxApuStats *s = &g_apu_stats;
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    int queued;
+    uint64_t played;
+
+    if (!s->last_ms) {
+        s->last_ms = now;
+        return;
+    }
+    if (now - s->last_ms < 1000)
+        return;
+    xa2_get_state(&queued, &played);
+    fprintf(stderr, "[APU-STATS] se=%u mon=%u SECTL=%08X FECTL=%08X mon_point=%d"
+            " voices=%u/%u/%u paused=%u idle=%u peak vp=%d bin=%d block=%d"
+            " out=%d submit ok=%u drop=%u xa2 queued=%d played=%llu sw_voices=%d\n",
+            s->se_frames, s->mon_frames,
+            (unsigned)qatomic_read(&d->regs[NV_PAPU_SECTL]),
+            (unsigned)qatomic_read(&d->regs[NV_PAPU_FECTL]), (int)d->monitor.point,
+            s->voices[0], s->voices[1], s->voices[2], s->paused, s->idle,
+            s->vp_peak, s->bin_peak, s->block_peak, s->out_peak,
+            s->out_ok, s->out_drop, queued, (unsigned long long)played,
+            (int)g_mixer_active_count);
+    fflush(stderr);
+    memset(s, 0, sizeof(*s));
+    s->enabled = 1;
+    s->last_ms = now;
+}
+
 /* ============================================================
  * APU frame thread (background processing)
  * ============================================================ */
@@ -577,11 +642,15 @@ static void *mcpx_apu_frame_thread(void *arg)
         if (apu_active && !g_test_tone.active) {
             /* Full pipeline: VP voices → DSP → monitor → waveOut */
             se_frame(d);
+            g_apu_stats.se_frames++;
         } else {
             /* Lightweight: just monitor frame (test tone + software mixer) */
             mcpx_apu_monitor_frame(d);
             d->ep_frame_div++;
+            g_apu_stats.mon_frames++;
         }
+        if (mcpx_apu_stats_on())
+            mcpx_apu_stats_tick(d);
 
         /* What xemu's frame thread does after each frame: turn a pending
          * notification (set by the voice processor or a trapped method) into
diff --git a/src/apu/apu_debug.h b/src/apu/apu_debug.h
index 5e8988d..4984bfe 100644
--- a/src/apu/apu_debug.h
+++ b/src/apu/apu_debug.h
@@ -91,6 +91,40 @@ struct McpxApuDebug
     bool gp_realtime, ep_realtime;
 };
 
+/* RECOMP_APU_STATS=1: per-second counters for "why is it silent" runs,
+ * printed as one [APU-STATS] line by the frame thread. Written only by the
+ * frame thread (under the device lock), reset after each line. Peaks are
+ * absolute sample values (float x 32767 for the VP/mixbin ones). */
+struct McpxApuStats
+{
+    int enabled;                /* -1 = env not read yet */
+    int64_t last_ms;
+    unsigned se_frames;         /* full VP -> DSP -> monitor frames */
+    unsigned mon_frames;        /* monitor-only frames (APU off/trapped) */
+    unsigned voices[3];         /* voice-frames processed, per voice list */
+    unsigned paused;            /* of those, paused */
+    unsigned idle;              /* inactive list entries (SE2FE_IDLE_VOICE) */
+    int vp_peak;                /* VP L/R sum (vp.sample_buf) */
+    int bin_peak;               /* any mixbin, before the DSP passthrough */
+    int block_peak;             /* frame_buf as the monitor found it */
+    int out_peak;               /* what was handed to the output */
+    unsigned out_ok, out_drop;  /* xa2_submit_samples accepted / refused */
+};
+extern struct McpxApuStats g_apu_stats;
+int mcpx_apu_stats_init(void);
+
+static inline int mcpx_apu_stats_on(void)
+{
+    return g_apu_stats.enabled < 0 ? mcpx_apu_stats_init()
+                                   : g_apu_stats.enabled;
+}
+
+static inline int mcpx_apu_peak_f(int peak, float s)
+{
+    int a = (int)((s < 0.0f ? -s : s) * 32767.0f);
+    return a > peak ? a : peak;
+}
+
 #ifdef __cplusplus
 extern "C" {
 #endif
