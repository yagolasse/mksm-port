From bfd21491964187d570da4aab679ac9851204eac8 Mon Sep 17 00:00:00 2001
From: Yago Lasse <yagolasse@gmail.com>
Date: Thu, 15 Oct 2026 14:50:53 -0300
Subject: [PATCH] kernel: xbox_Nv2aSoftwareMethod services D3D's software
 method 5

An external renderer that executes NO_OPERATION with a parameter (a software
method, which raises a PGRAPH interrupt on hardware) reports it here. Method 5
sets the event at miniport + 0x1A4 that D3D's pushbuffer-space wait blocks on;
the miniport is the context of the ISR connected on the NV2A vector. Other
methods are logged. KeSetEvent's body moves into ke_set_event so the runtime
can use it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/kernel_bridge.c | 61 +++++++++++++++++++++++++++++---------
 src/kernel/nv2a_pb_hook.h  |  6 ++++
 2 files changed, 53 insertions(+), 14 deletions(-)

diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
index 4a00feb..9bcde0c 100644
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -1963,25 +1963,20 @@ static HANDLE ke_guest_event_prepare(uint32_t guest_va, int *type)
     return h;
 }
 
-/* ── KeSetEvent (ordinal 145) ────────────────────────────── */
-static void bridge_KeSetEvent(void)
+/* KeSetEvent's work, also used by the runtime itself (xbox_Nv2aSoftwareMethod).
+ * Returns what KeSetEvent puts in eax. */
+static uint32_t ke_set_event(uint32_t guest_va)
 {
-    uint32_t guest_va = STACK_ARG(0);
-    uint32_t increment = STACK_ARG(1);
-    uint32_t wait = STACK_ARG(2);
     HANDLE h;
 
-    (void)increment;
-    (void)wait;
-
     {   /* An event the title built itself (see ke_guest_event). */
         int type;
         HANDLE ge = ke_guest_event(guest_va, &type);
         if (ge) {
-            g_eax = BRIDGE_MEM32(guest_va + 4) != 0;   /* previous state */
+            uint32_t prev = BRIDGE_MEM32(guest_va + 4) != 0;
             BRIDGE_MEM32(guest_va + 4) = 1;
             SetEvent(ge);
-            return;
+            return prev;
         }
     }
     h = ke_shadow_lookup(guest_va);
@@ -1989,10 +1984,19 @@ static void bridge_KeSetEvent(void)
         h = bridge_resolve_handle(guest_va);
     if (!h)
         h = XBOX_TO_NATIVE(guest_va);
-    if (h)
-        g_eax = (uint32_t)SetEvent(h);
-    else
-        g_eax = 0;
+    return h ? (uint32_t)SetEvent(h) : 0;
+}
+
+/* ── KeSetEvent (ordinal 145) ────────────────────────────── */
+static void bridge_KeSetEvent(void)
+{
+    uint32_t guest_va = STACK_ARG(0);
+    uint32_t increment = STACK_ARG(1);
+    uint32_t wait = STACK_ARG(2);
+
+    (void)increment;
+    (void)wait;
+    g_eax = ke_set_event(guest_va);
 }
 
 /* ── KeWaitForSingleObject (ordinal 159) ─────────────────── */
@@ -2883,6 +2887,35 @@ uint32_t xbox_GetConnectedInterrupt(uint32_t vector)
     return (vector < XBOX_MAX_VECTORS) ? g_connected_isr[vector] : 0;
 }
 
+/* A software method: NV097 NO_OPERATION with a non-zero parameter, which on
+ * hardware raises a PGRAPH error interrupt that D3D's interrupt handler (its
+ * DPC) services by the parameter's low 5 bits. The runtime delivers no PGRAPH
+ * interrupts, so a renderer that executes the pushbuffer reports each one here
+ * and the effect D3D depends on is reproduced directly:
+ *   - 5: set the event at miniport + 0x1A4, the one D3D's pushbuffer-space
+ *     wait (and BlockOnTime) blocks on until the GPU has reached the notify.
+ *     The miniport is the context of the ISR connected on the NV2A vector.
+ * Others are counted and the first few logged. Returns 1 when handled. */
+int xbox_Nv2aSoftwareMethod(uint32_t param)
+{
+    uint32_t kint = xbox_GetConnectedInterrupt(NV2A_VECTOR);
+    uint32_t miniport = kint ? BRIDGE_MEM32(kint + 4) : 0;
+
+    if ((param & 0x1Fu) == 5u && miniport) {
+        ke_set_event(miniport + 0x1A4u);
+        return 1;
+    }
+    {
+        static unsigned n;
+        if (n++ < 8) {
+            fprintf(stderr, "  [NV2A] software method 0x%08X not handled (miniport 0x%08X)\n",
+                    param, miniport);
+            fflush(stderr);
+        }
+    }
+    return 0;
+}
+
 /* ── MmClaimGpuInstanceMemory (ordinal 168) ───────────────
  * PVOID MmClaimGpuInstanceMemory(SIZE_T NumberOfBytes, SIZE_T *Padding)
  *
diff --git a/src/kernel/nv2a_pb_hook.h b/src/kernel/nv2a_pb_hook.h
index d8ba062..7047549 100644
--- a/src/kernel/nv2a_pb_hook.h
+++ b/src/kernel/nv2a_pb_hook.h
@@ -25,4 +25,10 @@ typedef void (*nv2a_pb_method_hook_fn)(uint32_t subch, uint32_t method,
 /* NULL restores the software executor. */
 void nv2a_pb_set_method_hook(nv2a_pb_method_hook_fn fn);
 
+/* A hook that runs software methods (NV097 NO_OPERATION with a non-zero
+ * parameter, which on hardware raise an interrupt for D3D's handler) reports
+ * each parameter here; the runtime reproduces what D3D's handler would do
+ * (kernel_bridge.c). Returns 1 if the method is handled. Any thread. */
+int xbox_Nv2aSoftwareMethod(uint32_t param);
+
 #endif
