From f065b14269aae2192b3501a9879d9ef144eb493d Mon Sep 17 00:00:00 2001
From: Yago Lasse <yagolasse@gmail.com>
Date: Fri, 16 Oct 2026 00:56:04 -0300
Subject: [PATCH] apu: sinc resampling for upsampled voices, voice dump and SGE
 trace

Voices played above their source rate (pitch < 48 kHz) now go through a
16-tap Blackman-windowed sinc instead of linear interpolation, which left
strong images of ~11 kHz effects played 4x up. RECOMP_APU_RESAMPLE=linear
restores the old path for A/B; voices at or below the output rate stay
linear.

Diagnostics:
- RECOMP_APU_VOICE_DUMP=<path>: every batch of source samples each voice
  fetches, as { u32 vp frame, u16 voice, u16 count, u32 cbo, s16 L/R... }
  records, for finding stale or corrupt sample data per voice.
- RECOMP_APU_TRACE_SGE=<voice>: logs each SGE entry that voice reads once
  per buffer, with the page it maps to, its origin tag and heap block,
  and how many ADPCM block headers look valid in heap RAM vs the window.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016ahYm8JBvCH5KhgtSu9Yoy
---
 src/apu/apu_vp.c | 196 ++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 184 insertions(+), 12 deletions(-)

diff --git a/src/apu/apu_vp.c b/src/apu/apu_vp.c
index bb0cb1c..167ac5b 100644
--- a/src/apu/apu_vp.c
+++ b/src/apu/apu_vp.c
@@ -125,14 +125,18 @@ static void voice_set_mask(MCPXAPUState *d, uint16_t voice_handle,
  * ============================================================ */
 
 /* Per-voice resampler state (voice_resample). Source samples fetched but
- * not yet passed (buf[0] is the one at the integer position) and the
- * fractional position into them. Reset when a voice is turned on. */
+ * not yet passed (with the sinc kernel also the SINC_HALF - 1 before the
+ * integer position) and the fractional position into them. Reset when a
+ * voice is turned on. */
 #define RS_MAX_STEP 8      /* source samples per output sample, at most */
-#define RS_BUF (NUM_SAMPLES_PER_FRAME * RS_MAX_STEP + 2)
+#define SINC_HALF 8        /* sinc kernel: taps on each side */
+#define SINC_PHASES 256
+#define RS_BUF (NUM_SAMPLES_PER_FRAME * RS_MAX_STEP + 2 + 2 * SINC_HALF)
 static struct {
     float buf[RS_BUF][2];
     int len;
     double frac;
+    bool primed;
 } s_rs[MCPX_HW_MAX_VOICES];
 
 /* RECOMP_APU_STATS=2: per-voice counters since the last [APU-VOICE] dump. */
@@ -145,10 +149,50 @@ struct VoiceStat {
 };
 static struct VoiceStat s_vstat[MCPX_HW_MAX_VOICES];
 
+/* RECOMP_APU_VOICE_DUMP=<path>: every batch of source samples a voice
+ * fetches, as records of { u32 vp frame, u16 voice, u16 count, u32 cbo
+ * before the fetch, count x { s16 L, s16 R } }, in fetch order. For
+ * finding stale or torn data in a voice's buffer (port tools/voicedump.py). */
+static FILE *s_vdump;
+static int s_vdump_state;   /* 0 = env not read, 1 = writing, -1 = off */
+static uint32_t s_vp_frame;
+
+static void vdump_write(uint16_t v, uint32_t cbo, float buf[][2], int count)
+{
+    if (!s_vdump_state) {
+        const char *p = getenv("RECOMP_APU_VOICE_DUMP");
+        s_vdump_state = -1;
+        if (p && *p) {
+            s_vdump = fopen(p, "wb");
+            if (s_vdump) {
+                s_vdump_state = 1;
+                fprintf(stderr, "[APU] dumping voice source samples to %s\n", p);
+            } else {
+                fprintf(stderr, "[APU] RECOMP_APU_VOICE_DUMP: cannot open %s\n", p);
+            }
+        }
+    }
+    if (s_vdump_state != 1 || count <= 0 || count > 0xFFFF)
+        return;
+    uint32_t hdr[3] = { s_vp_frame, (uint32_t)v | ((uint32_t)count << 16), cbo };
+    int16_t smp[64][2];
+    fwrite(hdr, 4, 3, s_vdump);
+    for (int i = 0; i < count; i += 64) {
+        int n = count - i < 64 ? count - i : 64;
+        for (int k = 0; k < n; k++)
+            for (int c = 0; c < 2; c++) {
+                float f = buf[i + k][c] * 32767.0f;
+                smp[k][c] = (int16_t)(f > 32767.0f ? 32767 : f < -32768.0f ? -32768 : f);
+            }
+        fwrite(smp, 4, n, s_vdump);
+    }
+}
+
 static void voice_resample_reset(uint16_t v)
 {
     s_rs[v].len = 0;
     s_rs[v].frac = 0.0;
+    s_rs[v].primed = false;
 }
 
 static void voice_off(MCPXAPUState *d, uint16_t v)
@@ -655,12 +699,55 @@ void mcpx_apu_vp_write(void *opaque, hwaddr addr, uint64_t val,
  * SGE data pointer resolution
  * ============================================================ */
 
+/* RECOMP_APU_TRACE_SGE=<voice>: log each SGE entry that voice reads the
+ * first time (per buffer start), with the page it maps to and its first
+ * bytes (plan 3.3d: a music voice decodes garbage from one page on). */
+static int s_sge_trace = -2;   /* -2 = env not read, -1 = off */
+static int s_sge_voice = -1;   /* voice voice_get_samples is reading */
+static uint32_t s_sge_ba;
+static uint8_t s_sge_seen[4096];
+extern uint32_t xbox_HeapBlockSize(uint32_t xbox_va);
+extern uint32_t xbox_ContiguousAllocatedBytes(void);
+extern int xbox_PhysPageOrigin(uint32_t pa);
+
+static void sge_trace(hwaddr sge_base, unsigned int entry, uint32_t prd)
+{
+    if (s_sge_seen[entry & 4095])
+        return;
+    s_sge_seen[entry & 4095] = 1;
+    const uint8_t *b = mcpx_apu_data_phys(prd);
+    /* ADPCM block headers in this page, read from heap RAM and from the
+     * contiguous window: { s16 sample, u8 step index <= 88, u8 0 } when the
+     * bytes are this voice's data */
+    uint32_t a = prd & 0x0FFFFFFFu;
+    const uint8_t *ram = g_apu_ram_ptr + (a & 0x03FFFFFFu);
+    const uint8_t *win = g_apu_ram_ptr + 0x80000000u + a;
+    uint32_t lin = entry * TARGET_PAGE_SIZE;
+    unsigned first = lin >= s_sge_ba ? (36 - (lin - s_sge_ba) % 36) % 36
+                                     : s_sge_ba - lin;
+    int ok_ram = 0, ok_win = 0, n = 0;
+    for (unsigned o = first; o + 4 <= TARGET_PAGE_SIZE; o += 36, n++) {
+        ok_ram += ram[o + 2] <= 88 && ram[o + 3] == 0;
+        ok_win += win[o + 2] <= 88 && win[o + 3] == 0;
+    }
+    fprintf(stderr, "[APU-SGE] v=%d ba=%06X entry=%03X sge=%08X prd=%08X origin=%d heap=%u"
+            " contig=%08X bytes=%02X%02X%02X%02X %02X%02X%02X%02X"
+            " adpcm headers ok: ram %d/%d win %d/%d\n",
+            s_sge_voice, s_sge_ba, entry, (uint32_t)sge_base, prd,
+            xbox_PhysPageOrigin(prd), xbox_HeapBlockSize(prd),
+            xbox_ContiguousAllocatedBytes(),
+            b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7],
+            ok_ram, n, ok_win, n);
+}
+
 static hwaddr get_data_ptr(hwaddr sge_base, unsigned int max_sge, uint32_t addr)
 {
     unsigned int entry = addr / TARGET_PAGE_SIZE;
     assert(entry <= max_sge);
     uint32_t prd_address =
         ldl_le_phys(address_space_memory, sge_base + entry * 4 * 2);
+    if (s_sge_trace >= 0 && s_sge_voice == s_sge_trace)
+        sge_trace(sge_base, entry, prd_address);
     return prd_address + addr % TARGET_PAGE_SIZE;
 }
 
@@ -853,6 +940,18 @@ static int voice_get_samples(MCPXAPUState *d, uint32_t v, float samples[][2],
     voice_set_mask(d, (uint16_t)v, NV_PAVS_VOICE_PAR_STATE,
                    NV_PAVS_VOICE_PAR_STATE_NEW_VOICE, 0);
 
+    if (s_sge_trace == -2) {
+        const char *e = getenv("RECOMP_APU_TRACE_SGE");
+        s_sge_trace = (e && *e) ? atoi(e) : -1;
+    }
+    if (s_sge_trace >= 0) {
+        s_sge_voice = (int)v;
+        if ((int)v == s_sge_trace && ba != s_sge_ba) {
+            s_sge_ba = ba;
+            memset(s_sge_seen, 0, sizeof(s_sge_seen));
+        }
+    }
+
     if (paused) return -1;
 
     if (stream) {
@@ -1025,7 +1124,8 @@ static int voice_get_samples(MCPXAPUState *d, uint32_t v, float samples[][2],
 }
 
 /* ============================================================
- * Voice resampling (linear interpolation; xemu uses libsamplerate)
+ * Voice resampling (windowed sinc when upsampling, else linear; xemu
+ * uses libsamplerate)
  *
  * rate is output/input, as xemu hands it to src_process: a voice's pitch
  * is 4096 * log2(f / 48000), so 24 kHz content has rate 2 and needs one
@@ -1035,8 +1135,49 @@ static int voice_get_samples(MCPXAPUState *d, uint32_t v, float samples[][2],
  *
  * Source samples are fetched in batches (voice_get_samples decodes a whole
  * ADPCM block per call) into s_rs[v].buf and carried across frames.
+ *
+ * Linear interpolation leaves strong images of the source spectrum above
+ * its Nyquist frequency. MKSM's footsteps and hits are ~11 kHz ADPCM played
+ * 4-4.5x up, and their transients came out as a harsh digital buzz (plan
+ * 3.3d). Upsampled voices therefore go through a 16-tap Blackman-windowed
+ * sinc with its cutoff just below the source Nyquist frequency.
+ * RECOMP_APU_RESAMPLE=linear brings back linear interpolation for A/B.
+ * Voices at or below the output rate (step >= 1) stay linear.
  * ============================================================ */
 
+static float s_sinc[SINC_PHASES + 1][2 * SINC_HALF];
+static int s_rs_mode = -1;   /* -1 = env not read, 0 = linear, 1 = sinc */
+
+static bool rs_sinc(void)
+{
+    if (s_rs_mode < 0) {
+        const char *e = getenv("RECOMP_APU_RESAMPLE");
+        s_rs_mode = (e && !strcmp(e, "linear")) ? 0 : 1;
+        if (s_rs_mode) {
+            const double fc = 0.9;   /* of the source Nyquist frequency */
+            for (int p = 0; p <= SINC_PHASES; p++) {
+                double t = (double)p / SINC_PHASES, sum = 0.0;
+                for (int k = 0; k < 2 * SINC_HALF; k++) {
+                    /* tap k weighs source sample i - (SINC_HALF - 1) + k for
+                     * the output at i + t */
+                    double x = k - (SINC_HALF - 1) - t;
+                    double sinc = (fabs(x) < 1e-9) ? 1.0
+                                : sin(M_PI * fc * x) / (M_PI * fc * x);
+                    double w = 0.42 + 0.5 * cos(M_PI * x / SINC_HALF)
+                             + 0.08 * cos(2.0 * M_PI * x / SINC_HALF);
+                    s_sinc[p][k] = (float)(sinc * w);
+                    sum += sinc * w;
+                }
+                for (int k = 0; k < 2 * SINC_HALF; k++)
+                    s_sinc[p][k] = (float)(s_sinc[p][k] / sum);   /* unity DC gain */
+            }
+        }
+        fprintf(stderr, "[APU] voice resampling: %s\n",
+                s_rs_mode ? "sinc (upsampling)" : "linear");
+    }
+    return s_rs_mode == 1;
+}
+
 static int voice_resample(MCPXAPUState *d, uint16_t v, float samples[][2],
                           int requested_num, float rate)
 {
@@ -1045,7 +1186,21 @@ static int voice_resample(MCPXAPUState *d, uint16_t v, float samples[][2],
     if (step < 1.0 / 64) step = 1.0 / 64;
 
     float (*buf)[2] = s_rs[v].buf;
-    int need = (int)(s_rs[v].frac + step * (requested_num - 1)) + 2;
+    /* Samples kept behind the integer position for the sinc's left taps;
+     * a new voice starts with that many zeros */
+    int hist = rs_sinc() ? SINC_HALF - 1 : 0;
+    if (!s_rs[v].primed) {
+        if (hist) {
+            memmove(buf + hist, buf, (size_t)s_rs[v].len * sizeof(buf[0]));
+            memset(buf, 0, (size_t)hist * sizeof(buf[0]));
+            s_rs[v].len += hist;
+            s_rs[v].frac += hist;
+        }
+        s_rs[v].primed = true;
+    }
+    bool sinc = hist && step < 1.0;
+    int ahead = sinc ? SINC_HALF : 1;   /* samples needed after i */
+    int need = (int)(s_rs[v].frac + step * (requested_num - 1)) + ahead + 1;
     if (need > RS_BUF) need = RS_BUF;
 
     /* Top up the source buffer */
@@ -1053,9 +1208,12 @@ static int voice_resample(MCPXAPUState *d, uint16_t v, float samples[][2],
         int active = voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
                                     NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE);
         if (!active) break;
+        uint32_t cbo = voice_get_mask(d, v, NV_PAVS_VOICE_PAR_OFFSET,
+                                      NV_PAVS_VOICE_PAR_OFFSET_CBO);
         int count = voice_get_samples(d, v, &buf[s_rs[v].len],
                                       need - s_rs[v].len);
         if (count <= 0) break;   /* ended or starved: use what we have */
+        vdump_write(v, cbo, &buf[s_rs[v].len], count);
         s_rs[v].len += count;
     }
 
@@ -1065,9 +1223,10 @@ static int voice_resample(MCPXAPUState *d, uint16_t v, float samples[][2],
     double frac = s_rs[v].frac;
     while (out < requested_num) {
         int i = (int)frac;
-        if (i + 1 >= len) {
-            /* Last sample of an ended voice: hold it rather than drop it */
-            if (i < len && !voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
+        if (i + ahead >= len) {
+            /* Last sample of an ended voice: hold it rather than drop it
+             * (the caller drops the frame of a voice that ended anyway) */
+            if (!sinc && i < len && !voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
                                            NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE)) {
                 samples[out][0] = buf[i][0];
                 samples[out][1] = buf[i][1];
@@ -1077,14 +1236,26 @@ static int voice_resample(MCPXAPUState *d, uint16_t v, float samples[][2],
             break;
         }
         float t = (float)(frac - i);
-        samples[out][0] = buf[i][0] + (buf[i + 1][0] - buf[i][0]) * t;
-        samples[out][1] = buf[i][1] + (buf[i + 1][1] - buf[i][1]) * t;
+        if (sinc) {
+            const float *h = s_sinc[(int)(t * SINC_PHASES + 0.5f)];
+            const float (*x)[2] = (const float (*)[2])&buf[i - (SINC_HALF - 1)];
+            float l = 0.0f, r = 0.0f;
+            for (int k = 0; k < 2 * SINC_HALF; k++) {
+                l += x[k][0] * h[k];
+                r += x[k][1] * h[k];
+            }
+            samples[out][0] = l;
+            samples[out][1] = r;
+        } else {
+            samples[out][0] = buf[i][0] + (buf[i + 1][0] - buf[i][0]) * t;
+            samples[out][1] = buf[i][1] + (buf[i + 1][1] - buf[i][1]) * t;
+        }
         out++;
         frac += step;
     }
 
-    /* Drop the source samples we've moved past */
-    int drop = (int)frac;
+    /* Drop the source samples we've moved past (keeping hist of them) */
+    int drop = (int)frac - hist;
     if (drop > len) drop = len;
     if (drop > 0) {
         memmove(buf, buf + drop, (size_t)(len - drop) * sizeof(buf[0]));
@@ -1388,6 +1559,7 @@ void mcpx_apu_vp_frame(MCPXAPUState *d,
                         float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME])
 {
     memset(d->vp.sample_buf, 0, sizeof(d->vp.sample_buf));
+    s_vp_frame++;
 
     for (int list = 0; list < 3; list++) {
         hwaddr top, current, next;
