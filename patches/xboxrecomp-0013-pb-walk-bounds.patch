From ee486c4bead4020eba03564c8e9294bec76e9c2b Mon Sep 17 00:00:00 2001
From: Yago Lasse <yagolasse@gmail.com>
Date: Thu, 15 Oct 2026 14:50:53 -0300
Subject: [PATCH] nv2a: stop the pushbuffer walk when it leaves the contiguous
 window

A JUMP or CALL decoded from something that isn't commands (an overwritten ring)
sent the walk outside guest memory and faulted. Log it and stop instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/nv2a_pb_scan.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/kernel/nv2a_pb_scan.c b/src/kernel/nv2a_pb_scan.c
index bfea616..bc51de6 100644
--- a/src/kernel/nv2a_pb_scan.c
+++ b/src/kernel/nv2a_pb_scan.c
@@ -28,6 +28,7 @@
 
 #ifndef XBOX_CONTIG_BASE
 #define XBOX_CONTIG_BASE 0x80000000u   /* physical P is at this + P */
+#define XBOX_CONTIG_SIZE (64u * 1024u * 1024u)
 #endif
 
 extern ptrdiff_t xbox_GetMemoryOffset(void);
@@ -176,6 +177,17 @@ static uint32_t pb_walk(uint32_t va, uint32_t end_va, int in_call, int ring,
     uint32_t words = 0;
 
     while ((ring ? va != end_va : va < end_va) && words < 0x100000u) {
+        if (va - XBOX_CONTIG_BASE >= XBOX_CONTIG_SIZE) {
+            /* A JUMP or CALL out of the window: the walk is reading
+             * something that isn't commands (stale or overwritten ring). */
+            static unsigned bad;
+            if (bad++ < 8)
+                fprintf(stderr, "[PB] walk left the contiguous window at 0x%08X "
+                        "(after JUMP 0x%08X -> 0x%08X, end 0x%08X, %u words, "
+                        "call %d)\n", va, nv2a_pb_ring_jump_from,
+                        nv2a_pb_ring_jump_to, end_va, words, in_call);
+            break;
+        }
         uint32_t w = *(const uint32_t *)(mem + va);
         va += 4;
         words++;
-- 
2.53.0.windows.2

