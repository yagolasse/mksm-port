diff --git a/src/apu/apu_core.c b/src/apu/apu_core.c
index ee1802e..8f44bc0 100644
--- a/src/apu/apu_core.c
+++ b/src/apu/apu_core.c
@@ -50,7 +50,7 @@ struct McpxApuStats g_apu_stats = { -1 };
 int mcpx_apu_stats_init(void)
 {
     const char *e = getenv("RECOMP_APU_STATS");
-    g_apu_stats.enabled = (e && *e && atoi(e) != 0);
+    g_apu_stats.enabled = (e && *e) ? atoi(e) : 0;   /* 2 = also per voice */
     return g_apu_stats.enabled;
 }
 
@@ -270,6 +270,10 @@ static void apu_deliver_irq(MCPXAPUState *d)
  * MMIO Read / Write
  * ============================================================ */
 
+/* The FEDECPARAM half of the last FEDECMETH read, per thread (see below). */
+static APU_TLS uint32_t s_fedec_param;
+static APU_TLS int s_fedec_latched;
+
 uint64_t mcpx_apu_read(void *opaque, hwaddr addr, unsigned int size)
 {
     MCPXAPUState *d = (MCPXAPUState *)opaque;
@@ -279,6 +283,31 @@ uint64_t mcpx_apu_read(void *opaque, hwaddr addr, unsigned int size)
     case NV_PAPU_XGSCNT:
         r = (uint64_t)(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 100);
         break;
+    /* FEDECMETH then FEDECPARAM is one decoded method, and the APU ISR reads
+     * them in that order. On the single-CPU console nothing runs between the
+     * two reads; here the ISR runs on the frame thread while game threads
+     * keep issuing FE methods, and DirectSound read METH = 0x8000 (idle
+     * voice, left from a trap) with PARAM = the voice the game had just
+     * selected -- and freed MKSM's playing music voice (plan 3.3c). So a
+     * METH read takes both under the lock fe_method writes them under, and
+     * the same thread's next PARAM read gets the matching half. */
+    case NV_PAPU_FEDECMETH:
+        qemu_mutex_lock(&d->lock);
+        r = qatomic_read(&d->regs[NV_PAPU_FEDECMETH]);
+        s_fedec_param = qatomic_read(&d->regs[NV_PAPU_FEDECPARAM]);
+        s_fedec_latched = 1;
+        qemu_mutex_unlock(&d->lock);
+        mcpx_apu_reg_event((uint32_t)addr | 0x10000, 0, (uint32_t)r);
+        break;
+    case NV_PAPU_FEDECPARAM:
+        if (s_fedec_latched) {
+            r = s_fedec_param;
+            s_fedec_latched = 0;
+        } else {
+            r = qatomic_read(&d->regs[NV_PAPU_FEDECPARAM]);
+        }
+        mcpx_apu_reg_event((uint32_t)addr | 0x10000, 0, (uint32_t)r);
+        break;
     default:
         if (addr < 0x20000) {
             r = qatomic_read(&d->regs[addr]);
@@ -313,6 +342,8 @@ void mcpx_apu_write(void *opaque, hwaddr addr, uint64_t val,
         break;
     case NV_PAPU_FECTL:
     case NV_PAPU_SECTL:
+        if (addr == NV_PAPU_FECTL)
+            mcpx_apu_reg_event((uint32_t)addr, d->regs[addr], (uint32_t)val);
         qatomic_set(&d->regs[addr], (uint32_t)val);
         /* Starting the APU has to start the frame thread.
          *
@@ -349,6 +380,8 @@ void mcpx_apu_write(void *opaque, hwaddr addr, uint64_t val,
         break;
     default:
         if (addr < 0x20000) {
+            if (addr >= NV_PAPU_TVL2D && addr <= NV_PAPU_TVL2D + 0x20)
+                mcpx_apu_reg_event((uint32_t)addr, d->regs[addr], (uint32_t)val);
             qatomic_set(&d->regs[addr], (uint32_t)val);
         }
         break;
@@ -681,7 +714,8 @@ static void mcpx_apu_stats_tick(MCPXAPUState *d)
             " voices=%u/%u/%u paused=%u idle=%u peak vp=%d bin=%d block=%d"
             " out=%d submit ok=%u drop=%u xa2 queued=%d played=%llu starved=%u"
             " sw_voices=%d data img=%u win=%u ram=%u amb heap=%u win=%u"
-            " (%08X-%08X) contig=%08X\n",
+            " (%08X-%08X) contig=%08X on=%u off=%u/%u strm=%u ssl_done=%u"
+            " strm_empty=%u lock wait=%u skip=%u\n",
             s->se_frames, s->mon_frames, s->stall_waits,
             (unsigned)qatomic_read(&d->regs[NV_PAPU_SECTL]),
             (unsigned)qatomic_read(&d->regs[NV_PAPU_FECTL]), (int)d->monitor.point,
@@ -691,10 +725,17 @@ static void mcpx_apu_stats_tick(MCPXAPUState *d)
             starved, (int)g_mixer_active_count,
             s->data_img, s->data_win, s->data_ram, s->amb_heap, s->amb_win,
             s->amb_lo, s->amb_hi,
-            (unsigned)xbox_ContiguousAllocatedBytes());
-    fflush(stderr);
-    memset(s, 0, sizeof(*s));
-    s->enabled = 1;
+            (unsigned)xbox_ContiguousAllocatedBytes(),
+            s->on, s->off_cmd, s->off, s->strm, s->ssl_done, s->strm_empty,
+            s->lock_waits, s->lock_skips);
+    {
+        int level = s->enabled;
+        if (level > 1)
+            mcpx_apu_vp_dump_voices(d);
+        fflush(stderr);
+        memset(s, 0, sizeof(*s));
+        s->enabled = level;
+    }
     s->last_ms = now;
 }
 
