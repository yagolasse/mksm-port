diff --git a/src/apu/apu_xaudio2.c b/src/apu/apu_xaudio2.c
index 3afec80..3bc474e 100644
--- a/src/apu/apu_xaudio2.c
+++ b/src/apu/apu_xaudio2.c
@@ -24,16 +24,26 @@
 
 #define XA2_SAMPLE_RATE   48000
 #define XA2_CHANNELS      2
-#define XA2_BUF_SAMPLES   1024   /* ~21ms per submission */
-#define XA2_NUM_BUFS      3
+/* One buffer per EP frame: the APU produces 256 samples every ~5.33 ms and
+ * submits each block as it is made. A 1,024-sample buffer filled from one
+ * 256-sample block played 4x too much per call (or 1/4 of the audio once the
+ * queue was full). The queue is deep enough to ride out the frame thread's
+ * millisecond-grained throttle; when it runs dry, XA2_PREFILL blocks of
+ * silence go in first so playback restarts with a cushion instead of
+ * starving again on the next late block. */
+#define XA2_BUF_SAMPLES   256    /* ~5.33 ms, one EP frame */
+#define XA2_NUM_BUFS      16     /* ~85 ms at most in flight */
+#define XA2_PREFILL       4      /* ~21 ms of silence after a starve */
 
 static IXAudio2               *g_xa2 = NULL;
 static IXAudio2MasteringVoice *g_xa2_master = NULL;
 static IXAudio2SourceVoice    *g_xa2_source = NULL;
 static int16_t                 g_xa2_bufs[XA2_NUM_BUFS][XA2_BUF_SAMPLES][2];
+static const int16_t           g_xa2_silence[XA2_BUF_SAMPLES][2];
 static int                     g_xa2_next_buf = 0;
 static int                     g_xa2_initialized = 0;
 static int                     g_xa2_frames_written = 0;
+static unsigned                g_xa2_starved = 0;
 
 int xa2_init(void)
 {
@@ -86,6 +96,7 @@ int xa2_init(void)
     g_xa2_next_buf = 0;
     g_xa2_initialized = 1;
     g_xa2_frames_written = 0;
+    g_xa2_starved = 0;
 
     fprintf(stderr, "[XA2] XAudio2 initialized (%d Hz stereo 16-bit, %d x %d-sample buffers)\n",
             XA2_SAMPLE_RATE, XA2_NUM_BUFS, XA2_BUF_SAMPLES);
@@ -125,8 +136,9 @@ int xa2_is_active(void)
     return g_xa2_initialized;
 }
 
-/* Submit a buffer of mixed samples to XAudio2.
- * Called from APU frame thread. Returns 1 if buffer was submitted. */
+/* Submit a buffer of mixed samples to XAudio2 (at most XA2_BUF_SAMPLES).
+ * Called from APU frame thread. Returns 1 if buffer was submitted, 0 if
+ * the queue is full (the block is dropped). */
 int xa2_submit_samples(const int16_t *samples, int num_samples)
 {
     XAUDIO2_VOICE_STATE state;
@@ -140,6 +152,19 @@ int xa2_submit_samples(const int16_t *samples, int num_samples)
     IXAudio2SourceVoice_GetState(g_xa2_source, &state, XAUDIO2_VOICE_NOSAMPLESPLAYED);
     if ((int)state.BuffersQueued >= XA2_NUM_BUFS) return 0;
 
+    /* Ran dry (or first submit): queue silence ahead of the block. All of
+     * them point at the same zero buffer, so the ring isn't touched. */
+    if (state.BuffersQueued == 0) {
+        memset(&xbuf, 0, sizeof(xbuf));
+        xbuf.AudioBytes = sizeof(g_xa2_silence);
+        xbuf.pAudioData = (const BYTE *)g_xa2_silence;
+        for (int i = 0; i < XA2_PREFILL; i++)
+            IXAudio2SourceVoice_SubmitSourceBuffer(g_xa2_source, &xbuf, NULL);
+        g_xa2_starved++;
+    }
+
+    /* The ring slot is free: at most XA2_NUM_BUFS - 1 ring buffers are
+     * queued and XAudio2 finishes them in submit order. */
     idx = g_xa2_next_buf;
     copy_samples = (num_samples > XA2_BUF_SAMPLES) ? XA2_BUF_SAMPLES : num_samples;
     memcpy(g_xa2_bufs[idx], samples, copy_samples * XA2_CHANNELS * sizeof(int16_t));
@@ -161,12 +186,13 @@ int xa2_get_buffer_size(void)
     return XA2_BUF_SAMPLES;
 }
 
