+int xbox_FramebufferWindowClientSize(uint32_t *width, uint32_t *height)
+{
+    LONG wh = s_client_wh;
+
+    if (width)
+        *width = (uint32_t)(wh >> 16) & 0xFFFF;
+    if (height)
+        *height = (uint32_t)wh & 0xFFFF;
+    return wh != 0;
+}
