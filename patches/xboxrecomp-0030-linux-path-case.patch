diff --git a/src/kernel/kernel_path.c b/src/kernel/kernel_path.c
index 37c3621..a831adf 100644
--- a/src/kernel/kernel_path.c
+++ b/src/kernel/kernel_path.c
@@ -645,6 +645,8 @@ translate:
 #include <sys/types.h>
 #include <errno.h>
 #include <fcntl.h>
+#include <dirent.h>
+#include <strings.h>
 
 static char s_game_dir[MAX_PATH];
 static char s_save_dir[MAX_PATH];
@@ -791,6 +793,61 @@ void xbox_path_init(const char* game_dir, const char* save_dir)
              s_game_dir, s_save_dir, s_user_dir);
 }
 
+/*
+ * Xbox file systems ignore case; titles open "d:\FRONT\MOVIES\MIDWAY.SFD"
+ * while an extracted disc may hold "front/movies/midway.sfd" (and a mix of
+ * both). Win32 needs nothing here. On POSIX, every component after the first
+ * `keep` bytes (the base directory, taken as given) that does not exist as
+ * spelled is replaced by the first directory entry that matches it ignoring
+ * case. The walk stops at the first component with no match at all: the rest
+ * is a file or directory the title is about to create, kept as spelled.
+ */
+static void resolve_case(char* path, size_t keep)
+{
+    char* comp = path + keep;
+    struct stat st;
+
+    while (*comp == '/')
+        comp++;
+    if (comp == path)
+        return;   /* relative base: never produced by the rules above */
+    while (*comp) {
+        char* end = strchr(comp, '/');
+        char  saved = end ? *end : '\0';
+        int   found = 0;
+
+        if (end) *end = '\0';
+        if (lstat(path, &st) == 0) {
+            found = 1;
+        } else if (errno == ENOENT) {
+            DIR* dir;
+            char sep = comp[-1];
+
+            comp[-1] = '\0';
+            dir = opendir(comp == path + 1 ? "/" : path);
+            comp[-1] = sep;
+            if (dir) {
+                struct dirent* de;
+                while ((de = readdir(dir)) != NULL) {
+                    if (strcasecmp(de->d_name, comp) == 0
+                        && strlen(de->d_name) == strlen(comp)) {
+                        memcpy(comp, de->d_name, strlen(comp));
+                        found = 1;
+                        break;
+                    }
+                }
+                closedir(dir);
+            }
+        }
+        if (end) *end = saved;
+        if (!found || !end)
+            return;
+        comp = end + 1;
+        while (*comp == '/')
+            comp++;
+    }
+}
+
 BOOL xbox_translate_path(const char* xbox_path, xbox_host_char* host_path_buf, DWORD buf_size)
 {
     const char* remainder = NULL;
@@ -842,6 +899,12 @@ BOOL xbox_translate_path(const char* xbox_path, xbox_host_char* host_path_buf, D
     return TRUE;
 
 translate:
+    /* As the Win32 backend: tools (the smoke test, the missing-file report's
+     * readers) key on this line, and the hook sees every translated path. */
+    if (g_xbox_path_hook)
+        g_xbox_path_hook(xbox_path);
+    fprintf(stderr, "  [PATH] %s\n", xbox_path);
+    fflush(stderr);
     {
         char remainder_posix[MAX_PATH];
         snprintf(remainder_posix, sizeof(remainder_posix), "%s", remainder);
@@ -867,6 +930,7 @@ translate:
             while (n > 1 && host_path_buf[n - 1] == '/')
                 host_path_buf[--n] = '\0';
         }
+        resolve_case(host_path_buf, strlen(base_dir));
 
         XBOX_TRACE(XBOX_LOG_PATH, "%s -> %s", xbox_path, host_path_buf);
         /* As the Win32 backend does: the bridge reads back the host path
diff --git a/tests/kernel_path_case_posix/CMakeLists.txt b/tests/kernel_path_case_posix/CMakeLists.txt
new file mode 100644
index 0000000..3ea2bdc
--- /dev/null
+++ b/tests/kernel_path_case_posix/CMakeLists.txt
@@ -0,0 +1,13 @@
+cmake_minimum_required(VERSION 3.20)
+project(kernel_path_case_posix C)
+if(WIN32)
+    message(FATAL_ERROR "This fixture exercises the POSIX path backend's case lookup")
+endif()
+set(CMAKE_C_STANDARD 11)
+# Only the path translation and the platform layer: no game or guest memory.
+add_subdirectory(../../src/platform platform)
+add_executable(kernel_path_case_posix_test test_main.c ../../src/kernel/kernel_path.c)
+target_include_directories(kernel_path_case_posix_test PRIVATE ../../src/kernel)
+target_link_libraries(kernel_path_case_posix_test PRIVATE platform)
+enable_testing()
+add_test(NAME kernel_path_case_posix COMMAND kernel_path_case_posix_test)
diff --git a/tests/kernel_path_case_posix/test_main.c b/tests/kernel_path_case_posix/test_main.c
new file mode 100644
index 0000000..d308ea5
--- /dev/null
+++ b/tests/kernel_path_case_posix/test_main.c
@@ -0,0 +1,74 @@
+/* The POSIX path backend's case-insensitive lookup: Xbox titles open
+ * "d:\FRONT\MOVIES\MIDWAY.SFD" while an extracted disc holds
+ * "front/movies/midway.sfd" (or a mix). Components that exist keep their
+ * spelling on disk; a missing tail (a file about to be created) stays as the
+ * title spelled it. Also checks the [PATH] hook fires as on Win32. */
+#define _GNU_SOURCE
+#include "kernel.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+void xbox_log(int level, const char *subsystem, const char *fmt, ...)
+{ (void)level; (void)subsystem; (void)fmt; }
+
+const char *xbox_LookupSymbolicLink(const char *link)
+{ (void)link; return NULL; }
+
+static int failures, hook_calls;
+static void check(int ok, const char *name)
+{
+    printf("%s: %s\n", name, ok ? "PASS" : "FAIL");
+    if (!ok) failures++;
+}
+static void hook(const char *p) { (void)p; hook_calls++; }
+
+static void expect(const char *root, const char *guest, const char *rel, const char *name)
+{
+    char host[MAX_PATH], want[MAX_PATH];
+    int ok = xbox_translate_path(guest, host, MAX_PATH);
+    snprintf(want, sizeof want, "%s/%s", root, rel);
+    if (!ok || strcmp(host, want) != 0)
+        printf("  got %s\n  want %s\n", host, want);
+    check(ok && strcmp(host, want) == 0, name);
+}
+static void touch(const char *root, const char *rel)
+{
+    char p[MAX_PATH]; FILE *f;
+    snprintf(p, sizeof p, "%s/%s", root, rel);
+    f = fopen(p, "wb"); if (f) fclose(f);
+}
+static void mk(const char *root, const char *rel)
+{
+    char p[MAX_PATH];
+    snprintf(p, sizeof p, "%s/%s", root, rel);
+    mkdir(p, 0700);
+}
+int main(void)
+{
+    char root[] = "/tmp/xbox-path-case-XXXXXX", cmd[600];
+    if (!mkdtemp(root)) return 2;
+    mk(root, "front"); mk(root, "front/movies"); touch(root, "front/movies/midway.sfd");
+    touch(root, "GAMEDATA.WAD"); mk(root, "English"); touch(root, "English/Text.Bin");
+    xbox_path_init(root, root);
+    g_xbox_path_hook = hook;
+
+    expect(root, "d:\\FRONT\\MOVIES\\MIDWAY.SFD", "front/movies/midway.sfd",
+           "upper-case guest path finds the lower-case file");
+    expect(root, "d:\\gamedata.wad", "GAMEDATA.WAD",
+           "lower-case guest path finds the upper-case file");
+    expect(root, "d:\\english\\TEXT.BIN", "English/Text.Bin", "mixed case on disk");
+    expect(root, "d:\\front\\movies\\midway.sfd", "front/movies/midway.sfd",
+           "exact spelling unchanged");
+    expect(root, "d:\\FRONT\\NEW\\File.Dat", "front/NEW/File.Dat",
+           "missing tail kept as spelled after the matched prefix");
+    expect(root, "d:\\FRONT\\MOVIES\\MIDWAY.SFDX", "front/movies/MIDWAY.SFDX",
+           "no prefix match on a longer name");
+    check(hook_calls == 6, "path hook called once per translation");
+
+    snprintf(cmd, sizeof cmd, "rm -rf '%s'", root);
+    if (system(cmd) != 0) failures++;
+    return failures ? 1 : 0;
+}
