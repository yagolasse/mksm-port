     IXAudio2SourceVoice_GetState(g_xa2_source, &state, 0);
     *queued = (int)state.BuffersQueued;
@@ -180,6 +206,6 @@ void xa2_shutdown(void)                               {}
 int  xa2_is_active(void)                              { return 0; }
 int  xa2_submit_samples(const int16_t *s, int n)      { (void)s; (void)n; return 0; }
 int  xa2_get_buffer_size(void)                        { return 0; }
-void xa2_get_state(int *q, uint64_t *p)               { *q = 0; *p = 0; }
+void xa2_get_state(int *q, uint64_t *p, unsigned *s)  { *q = 0; *p = 0; *s = 0; }
 
 #endif /* _WIN32 */
