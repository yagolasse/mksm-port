+++ b/src/kernel/xbox_memory_layout.c
@@ -656,8 +656,19 @@ static LONG CALLBACK ac97_write_veh(PEXCEPTION_POINTERS ep)
     return EXCEPTION_CONTINUE_SEARCH;
